---
import { scorecard } from "../../data/talent";

/**
 * The live interview scorecard that overlaps the intro photo — Figma 501:3605.
 *
 * Built in DOM rather than exported so the meters recolour with the tokens and
 * can be animated later if the card is ever asked to fill on scroll.
 */
const { role, status, rows, verdict, overall } = scorecard;
---

<figure class="score">
  <figcaption class="score__head">
    <span class="score__role">{role}</span>
    <span class="score__status">{status}</span>
  </figcaption>

  <div class="score__rows">
    {
      rows.map((r) => (
        <div class="score__row">
          <div class="score__line">
            <span>{r.label}</span>
            <span>{r.score}</span>
          </div>
          <div class="score__track">
            <span class="score__fill" style={`width:${r.bar}%`} />
          </div>
        </div>
      ))
    }
  </div>

  <div class="score__foot">
    <span class="score__verdict">{verdict}</span>
    <span class="score__overall">{overall}</span>
  </div>
</figure>

<style>
  .score {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 16px;
    overflow: hidden;
    background: var(--c-surface);
    border-radius: var(--r-card);
    box-shadow: -1px 0 48px -4px rgba(131, 77, 251, 0.24);
  }

  .score__head {
    display: flex;
    align-items: center;
    gap: 32px;
    padding-bottom: 16px;
    border-bottom: 0.8px solid var(--c-card-border-strong);
    white-space: nowrap;
  }

  .score__role {
    font-weight: 600;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    letter-spacing: var(--tr-body);
    color: var(--c-ink);
  }

  .score__status {
    font-weight: 500;
    font-size: var(--fs-xxs);
    line-height: var(--lh-body);
    color: var(--c-live);
  }

  .score__rows {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .score__row {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .score__line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: var(--fs-sm);
    line-height: var(--lh-body);
    color: var(--c-ink);
    white-space: nowrap;
  }

  .score__track {
    overflow: hidden;
    height: 6px;
    background: var(--c-meter-track);
    border-radius: 24px;
  }

  .score__fill {
    display: block;
    height: 100%;
    background: var(--c-accent);
    border-radius: 24px;
  }

  .score__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 16px;
    border-top: 0.8px solid var(--c-card-border-strong);
  }

  /* A status label, not a control — it only borrows the pill's shape. */
  .score__verdict {
    padding: 6px 12px;
    border: 1px solid var(--c-accent);
    border-radius: var(--r-pill);
    rotate: var(--tilt);
    font-weight: 500;
    font-size: var(--fs-xs);
    line-height: var(--lh-button);
    color: var(--c-accent);
    white-space: nowrap;
  }

  .score__overall {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--c-ink);
  }
</style>
