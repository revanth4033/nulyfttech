---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "./Icon.astro";

/**
 * Chrome-style browser bar used above product screenshots.
 *
 * Shared by the hero summary card (578px) and the What We Do media panels
 * (450px). The bar heights are identical in both Figma frames — 28.17px
 * control bar + 25.49px toolbar — only the width differs, which the URL bar
 * absorbs.
 */
interface Props {
  url?: string;
  tab?: string;
  /**
   * `sm` is the 53.67px bar used in the hero card and the What We Do panels.
   * `lg` is the case-study variant: same 28.17px control bar, but a taller
   * 35.84px URL row with a chunkier URL pill.
   */
  size?: "sm" | "lg";
  /**
   * The Studio frame (667:3302) draws its browser bars with a Google tab
   * favicon and a photo avatar; everywhere else uses the nuLyft mark and a
   * gradient disc. Pass either to override.
   */
  favicon?: ImageMetadata;
  avatar?: ImageMetadata;
  class?: string;
}

const {
  url = "https://nulyfttech.com/",
  tab = "nuLyft T",
  size = "sm",
  favicon,
  avatar,
  class: className,
} = Astro.props;
---

<div class:list={["chrome", `chrome--${size}`, className]} aria-hidden="true">
  <div class="chrome__bar">
    <Icon name="browser/traffic-lights" width={34.88} height={8.05} class="chrome__lights" />

    <div class="chrome__tab">
      <span class="chrome__favicon">
        {
          favicon ? (
            <Image src={favicon} alt="" width={22} height={22} />
          ) : (
            <Icon name="brand/nulyft-logo" width={10.7} height={10.7} />
          )
        }
      </span>
      <span class="chrome__tabname">{tab}</span>
      <Icon name="browser/close" size={12} />
    </div>

    <Icon name="browser/plus" width={13.4} height={13.4} />
  </div>

  <div class="chrome__toolbar">
    <Icon name="browser/nav-icons" width={73.12} height={10.73} />

    <div class="chrome__url">
      <Icon name="browser/lock" width={8} height={8} />
      <span class="chrome__url-text">{url}</span>
      <Icon name="browser/star" width={10.7} height={10.7} class="chrome__star" />
    </div>

    <div class="chrome__right">
      {
        avatar ? (
          <Image src={avatar} alt="" width={30} height={30} class="chrome__avatar chrome__avatar--photo" />
        ) : (
          <span class="chrome__avatar"></span>
        )
      }
      <Icon name="browser/more" width={10.7} height={10.7} />
    </div>
  </div>
</div>

<style>
  .chrome {
    --toolbar-h: 25.5px;
    --url-h: 18.78px;
    --url-r: 9.4px;
    font-family: var(--font-sans);
  }

  .chrome--lg {
    --toolbar-h: 35.84px;
    --url-h: 26.49px;
    --url-r: 13.25px;
  }

  .chrome__bar {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 28.17px;
    padding-inline: 8.7px;
    background: #dee1e6;
  }

  .chrome__lights {
    margin-right: 5px;
  }

  .chrome__tab {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 22.8px;
    padding-inline: 5.4px;
    background: var(--c-surface);
    border-radius: 5.4px 5.4px 0 0;
  }

  .chrome__favicon {
    display: grid;
    place-items: center;
    width: 10.7px;
    height: 10.7px;
  }

  .chrome__favicon :global(img) {
    width: 10.7px;
    height: 10.7px;
  }

  .chrome__tabname {
    font-size: 8px;
    letter-spacing: 0.2px;
    color: #494c4f;
    white-space: nowrap;
  }

  .chrome__toolbar {
    display: flex;
    align-items: center;
    gap: 8px;
    height: var(--toolbar-h);
    padding-inline: 8px 9.4px;
    background: var(--c-surface);
    box-shadow: inset 0 -0.671px 0 #dadce0;
  }

  .chrome__url {
    display: flex;
    align-items: center;
    gap: 6.7px;
    flex: 1;
    min-width: 0;
    height: var(--url-h);
    padding-inline: 7.4px 6.5px;
    background: #f1f3f4;
    border-radius: var(--url-r);
  }

  /* A class, not a bare `span`: <Icon> renders a span too, and the bare
     selector gave the lock icon `flex: 1`, pushing the URL to the middle. */
  .chrome__url-text {
    flex: 1;
    overflow: hidden;
    font-size: 9.4px;
    letter-spacing: 0.168px;
    color: #202124;
    white-space: nowrap;
  }

  .chrome__url :global(.chrome__star) {
    margin-left: auto;
  }

  .chrome__right {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .chrome__avatar {
    width: 14.76px;
    height: 14.76px;
    border-radius: 50%;
    background: linear-gradient(140deg, #c9b6fd, #834dfb);
  }

  /* Global: the scoped rule above does not reach an <Image> component. */
  .chrome :global(.chrome__avatar--photo) {
    width: 14.76px;
    height: 14.76px;
    border-radius: 50%;
    object-fit: cover;
  }
</style>
