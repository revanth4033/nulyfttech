---
import CapabilityCard from "./CapabilityCard.astro";
import StatCard from "./StatCard.astro";
import Icon from "../ui/Icon.astro";
import { cardScenes } from "../../data/hero";

/**
 * The animated right-hand area of the hero.
 *
 * Every element is positioned in the Figma frame's coordinate space, but
 * anchored from the RIGHT edge so the composition holds together as the
 * viewport narrows (the text column stays anchored left).
 *
 * Figma left -> right conversion, frame width 1440:
 *   card A  left 822  w247 -> right 371, top 251
 *   card B  left 1093 w247 -> right 100, top 425
 *   pill    left 963  w221 -> right 256, top 462
 *   stat    left 767  w578 -> right  95, top 302
 */
---

<div class="stage" data-hero-stage aria-hidden="true">
  <!-- Directional blur used while elements are in flight. Horizontal only,
       which is what reads as motion blur; an isotropic blur just looks soft. -->
  <svg class="stage__defs" width="0" height="0">
    <defs>
      <filter id="hero-motion-blur" x="-50%" y="-20%" width="200%" height="140%" color-interpolation-filters="sRGB">
        <feGaussianBlur data-motion-blur in="SourceGraphic" stdDeviation="0 0"></feGaussianBlur>
      </filter>
    </defs>
  </svg>

  <div class="stage__glow" data-stage-glow></div>

  <!-- Scene 0: the pill the cursor clicks to start everything. -->
  <div class="stage__pill-group" data-scene="pill">
    <div class="stage__pill" data-stage-pill>
      <span>Start Your Project nuLyft</span>
    </div>
    <Icon name="icons/cursor" size={32} class="stage__cursor" data-stage-cursor />
  </div>

  <!-- Scenes 1..n: the capability card pairs. -->
  {
    cardScenes.map((scene, i) => (
      <div class="stage__cards" data-scene="cards" data-scene-index={i}>
        <div class="stage__card stage__card--a"><CapabilityCard card={scene.cards[0]} /></div>
        <div class="stage__card stage__card--b"><CapabilityCard card={scene.cards[1]} /></div>
      </div>
    ))
  }

  <!-- Final scene: the summary card. -->
  <div class="stage__stat" data-scene="stat">
    <StatCard />
  </div>
</div>

<style>
  .stage {
    position: absolute;
    inset: 0;
    z-index: var(--z-stage);
    pointer-events: none;
  }

  .stage__defs {
    position: absolute;
    width: 0;
    height: 0;
  }

  /* Scenes start hidden so nothing flashes before the timeline boots.
     With JS off (or reduced motion on) the stage settles on the final
     summary card rather than stacking every scene on top of each other. */
  .stage__pill-group,
  .stage__cards,
  .stage__stat,
  .stage__glow {
    opacity: 0;
  }

  :global(html.no-js) .stage__stat,
  :global(html.reduced-motion) .stage__stat,
  :global(html.no-js) .stage__glow,
  :global(html.reduced-motion) .stage__glow {
    opacity: 1;
  }

  :global(html.reduced-motion) .stage__glow {
    opacity: 0.5;
  }

  /* Sized for the card scenes; the stat scene scales this up by 1.23,
     which is exactly 492x400 — so the glow never needs a layout change. */
  .stage__glow {
    position: absolute;
    top: 231px;   /* 314 - 83 */
    right: 135px;
    width: 400px;
    height: 325px;
    border-radius: var(--r-pill);
    background: var(--c-accent-glow);
    filter: blur(200px);
    opacity: 0;
    will-change: transform, opacity;
  }

  /* --- scene: pill ------------------------------------------------------ */

  .stage__pill-group {
    position: absolute;
    top: 379px;   /* 462 - 83 */
    right: 256px;
    width: 221px;
    height: 68px;
  }

  .stage__pill {
    position: absolute;
    inset: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding: 8px 16px;
    border-radius: var(--r-pill);
    background-image: var(--grad-pill);
    box-shadow: var(--sh-button-inset);
    color: #fff;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: var(--fs-body);
    line-height: var(--lh-button);
    white-space: nowrap;
    rotate: var(--tilt);
  }

  .stage :global(.stage__cursor) {
    position: absolute;
    top: 36px;
    left: 152px;
  }

  /* --- scene: card pairs ------------------------------------------------ */

  .stage__cards {
    position: absolute;
    inset: 0;
  }

  .stage__card {
    position: absolute;
  }

  .stage__card--a {
    top: 168px;   /* 251 - 83 */
    right: 371px;
  }

  .stage__card--b {
    top: 342px;   /* 425 - 83 */
    right: 100px;
  }

  /* --- scene: stat card ------------------------------------------------- */

  .stage__stat {
    position: absolute;
    top: 219px;   /* 302 - 83 */
    right: 95px;
  }

  /* --- responsive ------------------------------------------------------- */

  @media (max-width: 1439px) {
    .stage {
      transform: scale(var(--stage-scale, 1));
      transform-origin: 100% 50%;
    }
  }

  @media (max-width: 1380px) { .stage { --stage-scale: 0.92; } }
  @media (max-width: 1280px) { .stage { --stage-scale: 0.84; } }
  @media (max-width: 1180px) { .stage { --stage-scale: 0.76; } }

  /* Below this the hero stacks and the stage is centred under the copy. */
  @media (max-width: 1080px) {
    .stage {
      position: relative;
      height: 620px;
      transform: none;
    }

    .stage__glow,
    .stage__pill-group,
    .stage__cards,
    .stage__stat {
      right: auto;
      left: 50%;
    }

    .stage__pill-group { top: 260px; translate: -50% 0; }
    .stage__glow { top: 150px; translate: -50% 0; }
    .stage__stat { top: 90px; translate: -50% 0; scale: 0.78; transform-origin: top center; }
    .stage__cards { top: 0; translate: -50% 0; width: 560px; }
    .stage__card--a { top: 20px; right: auto; left: 0; }
    .stage__card--b { top: 194px; right: auto; left: 271px; }
  }

  @media (max-width: 620px) {
    .stage { height: 520px; }
    .stage__cards { scale: 0.62; transform-origin: top center; }
    .stage__stat { scale: 0.52; }
    .stage__pill-group { scale: 0.9; top: 210px; }
  }
</style>
