---
import PreviewCard from "./PreviewCard.astro";
import PipelineCard from "./PipelineCard.astro";
import Icon from "../ui/Icon.astro";
import { heroScenes } from "../../data/hero";

/**
 * The animated right-hand area of the hero.
 *
 * Every element is positioned in the Figma frame's coordinate space, but
 * anchored from the RIGHT edge so the composition holds together as the
 * viewport narrows (the text column stays anchored left). Stage `top` is the
 * Figma value minus the 83px nav, which `.hero__frame` already clears.
 *
 * Card placement is per scene rather than per stage, because the pairs are not
 * all the same size: the automation pair is 271.5 wide and sits further left
 * than the three preview pairs. Slots live in `data/hero.ts` with the copy.
 *
 * Figma left -> right conversion, frame width 1440:
 *   glow    left 905  w400 -> right 135, top 314
 *   pill    left 963  w221 -> right 256, top 462
 */
---

<div class="stage" data-hero-stage aria-hidden="true">
  <!-- Directional blur used while elements are in flight. Horizontal only,
       which is what reads as motion blur; an isotropic blur just looks soft. -->
  <svg class="stage__defs" width="0" height="0">
    <defs>
      <filter id="hero-motion-blur" x="-50%" y="-20%" width="200%" height="140%" color-interpolation-filters="sRGB">
        <feGaussianBlur data-motion-blur in="SourceGraphic" stdDeviation="0 0"></feGaussianBlur>
      </filter>
    </defs>
  </svg>

  <div class="stage__glow" data-stage-glow></div>

  <!-- Everything that moves lives in the field, which clips. The glow does
       not: a 200px blur inside a clip becomes a hard-edged rectangle. -->
  <div class="stage__field" data-stage-field>
    <!-- Scene 0: the pill the cursor clicks to start everything. -->
    <div class="stage__pill-group" data-scene="pill">
      <div class="stage__pill" data-stage-pill>
        <span>Start Your Project nuLyft</span>
      </div>
      <Icon name="icons/cursor" size={32} class="stage__cursor" data-stage-cursor />
    </div>

    <!-- Scenes 1..4: the card pairs, lower-left card first. -->
    {
      heroScenes.map((scene, i) => (
        <div class="stage__cards" data-scene="cards" data-scene-index={i} data-scene-id={scene.id}>
          {scene.cards.map((card, j) => (
            <div
              class:list={["stage__card", j === 0 ? "stage__card--a" : "stage__card--b"]}
              style={`--card-w:${scene.slots[j].w}px;--card-right:${scene.slots[j].right}px;--card-top:${scene.slots[j].top}px`}
            >
              {card.kind === "preview" ? <PreviewCard card={card} /> : <PipelineCard card={card} />}
            </div>
          ))}
        </div>
      ))
    }
  </div>
</div>

<style>
  .stage {
    position: absolute;
    inset: 0;
    z-index: var(--z-stage);
    pointer-events: none;
  }

  .stage__defs {
    position: absolute;
    width: 0;
    height: 0;
  }

  /* The threshold the loop plays behind.
     Nothing is drawn here — the box only clips, so cards slide in and out past
     an edge instead of fading up in open space. Its right edge is the stage's,
     and 700 puts the left edge between the leftmost card at rest (667 from the
     right) and the copy column's right edge (722 at 1440). Full stage height,
     so only the two sides bite; the flight is horizontal. */
  .stage__field {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: var(--stage-field-w, 700px);
    overflow: clip;
  }

  /* Scenes start hidden so nothing flashes before the timeline boots.
     With JS off (or reduced motion on) the stage settles on the first pair
     rather than stacking all four on top of each other. */
  .stage__pill-group,
  .stage__cards,
  .stage__glow {
    opacity: 0;
  }

  :global(html.no-js) .stage__cards[data-scene-index="0"],
  :global(html.reduced-motion) .stage__cards[data-scene-index="0"],
  :global(html.no-js) .stage__glow,
  :global(html.reduced-motion) .stage__glow {
    opacity: 1;
  }

  :global(html.reduced-motion) .stage__glow {
    opacity: 0.5;
  }

  .stage__glow {
    position: absolute;
    top: 231px;   /* 314 - 83 */
    right: 135px;
    width: 400px;
    height: 325px;
    border-radius: var(--r-pill);
    background: var(--c-accent-glow);
    filter: blur(200px);
    opacity: 0;
    will-change: transform, opacity;
  }

  /* --- scene: pill ------------------------------------------------------ */

  .stage__pill-group {
    position: absolute;
    top: 379px;   /* 462 - 83 */
    right: 256px;
    width: 221px;
    height: 68px;
  }

  .stage__pill {
    position: absolute;
    inset: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding: 8px 16px;
    border-radius: var(--r-pill);
    background-image: var(--grad-pill);
    box-shadow: var(--sh-button-inset);
    color: #fff;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: var(--fs-body);
    line-height: var(--lh-button);
    white-space: nowrap;
    rotate: var(--tilt);
  }

  .stage :global(.stage__cursor) {
    position: absolute;
    top: 36px;
    left: 152px;
  }

  /* --- scene: card pairs ------------------------------------------------ */

  .stage__cards {
    position: absolute;
    inset: 0;
  }

  /* One rule for both cards — the diagonal is data now, not a class. The
     frames run lower-left to upper-right; the old pair ran the other way. */
  .stage__card {
    position: absolute;
    top: var(--card-top);
    right: var(--card-right);
    width: var(--card-w);
  }

  /* --- responsive ------------------------------------------------------- */

  @media (max-width: 1439px) {
    .stage {
      transform: scale(var(--stage-scale, 1));
      transform-origin: 100% 50%;
    }
  }

  @media (max-width: 1380px) { .stage { --stage-scale: 0.92; } }
  @media (max-width: 1280px) { .stage { --stage-scale: 0.84; } }
  @media (max-width: 1180px) { .stage { --stage-scale: 0.76; } }

  /* Below this the hero stacks and the stage is centred under the copy. The
     pairs are re-laid side by side from the left rather than by their frame
     offsets, which are measured against a 1440 column that no longer exists. */
  @media (max-width: 1080px) {
    /* 620 left ~200px of dead air under the pair — the tallest card bottoms
       out at 420. The stage is sized to the composition instead. */
    .stage {
      position: relative;
      height: 460px;
      transform: none;
    }

    /* The composition is centred rather than right-anchored down here, so the
       field takes the whole stage and clips at its own edges. */
    .stage__field {
      inset: 0;
      width: auto;
    }

    .stage__glow,
    .stage__pill-group,
    .stage__cards {
      right: auto;
      left: 50%;
    }

    .stage__pill-group { top: 190px; translate: -50% 0; }
    .stage__glow { top: 90px; translate: -50% 0; }
    .stage__cards { top: 0; translate: -50% 0; width: 560px; }

    .stage__card--a { top: 130px; right: auto; left: 0; }
    .stage__card--b { top: 0; right: auto; left: 288px; }
  }

  /* Scaled 0.62, the pair occupies 260 of the stage; 300 leaves it room to
     breathe without the 260px of empty page the old 520 produced. */
  @media (max-width: 620px) {
    .stage { height: 300px; }
    .stage__cards { scale: 0.62; transform-origin: top center; }
    .stage__pill-group { scale: 0.9; top: 115px; }
    .stage__glow { top: 40px; }
  }
</style>
