---
import BrowserChrome from "../ui/BrowserChrome.astro";
import Icon from "../ui/Icon.astro";
import { statScene } from "../../data/hero";

const s = statScene;
---

<article class="stat" data-hero-stat>
  <!-- Decorative browser chrome; the real content sits below it. -->
  <div class="stat__chrome">
    <BrowserChrome url={s.url} tab={s.tab} />
  </div>

  <!-- Skewed 1.6deg exactly as in the Figma frame, clipped by the card. -->
  <div class="stat__body">
    <div class="stat__lede">
      <p class="stat__figure" data-stat-part>{s.figure}</p>
      <h3 class="stat__title" data-stat-part>{s.title}</h3>
      <p class="stat__copy" data-stat-part>{s.body}</p>
    </div>

    <dl class="stat__row">
      {
        s.stats.map((item) => (
          <div class="stat__item" data-stat-part>
            <dt>{item.value}</dt>
            <dd>{item.label}</dd>
          </div>
        ))
      }
    </dl>

    <Icon name="brand/abstract-curves" width={100} height={95.6} class="stat__curves" />
  </div>
</article>

<style>
  .stat {
    position: relative;
    width: 578px;
    height: 407px;
    overflow: hidden;
    background: var(--c-surface);
    border: 1.358px solid var(--c-card-border);
    border-radius: var(--r-browser);
    box-shadow: var(--sh-browser);
    font-family: var(--font-sans);
  }

  .stat__chrome {
    position: absolute;
    inset: 0 0 auto;
    transform: skewX(1.6deg) rotate(0.16deg);
    transform-origin: top center;
  }

  /* --- content ---------------------------------------------------------- */

  .stat__body {
    position: absolute;
    top: 54.65px;
    left: 0;
    width: 572px;
    height: 343px;
    background: var(--c-surface);
    transform: skewX(1.6deg);
    transform-origin: top center;
  }

  .stat__lede {
    position: absolute;
    top: 32px;
    left: 32px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 508px;
  }

  .stat__figure {
    font-weight: 700;
    font-size: 32px;
    line-height: 1.2;
    color: var(--c-accent);
  }

  .stat__title {
    font-weight: 500;
    font-size: var(--fs-body);
    line-height: 22px;
    letter-spacing: var(--tr-label);
    color: var(--c-ink);
  }

  .stat__copy {
    font-size: var(--fs-xs);
    line-height: 20px;
    letter-spacing: var(--tr-body);
    color: var(--c-muted);
  }

  .stat__row {
    position: absolute;
    top: 193px;
    left: 32px;
    display: flex;
    justify-content: space-between;
    width: 508px;
  }

  .stat__item {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .stat__item dt {
    font-weight: 700;
    font-size: var(--fs-lg);
    line-height: 1.2;
    color: var(--c-ink);
  }

  .stat__item dd {
    font-weight: 500;
    font-size: var(--fs-sm);
    line-height: 22px;
    letter-spacing: var(--tr-card);
    color: var(--c-muted);
  }

  .stat :global(.stat__curves) {
    position: absolute;
    top: -1.5px;
    left: 471.78px;
  }
</style>
