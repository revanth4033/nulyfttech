---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/sections/Hero.astro";
import KeyHighlights from "../components/sections/KeyHighlights.astro";
import WhatWeDo from "../components/sections/WhatWeDo.astro";
import WhatWeDoDark from "../components/sections/WhatWeDoDark.astro";
import SelectedWork from "../components/sections/SelectedWork.astro";
import WhyNulyft from "../components/sections/WhyNulyft.astro";
import OurProcess from "../components/sections/OurProcess.astro";
import Technology from "../components/sections/Technology.astro";
import Industries from "../components/sections/Industries.astro";
import Clients from "../components/sections/Clients.astro";
import CtaFooter from "../components/sections/CtaFooter.astro";
---

<BaseLayout
  title="nuLyft — Enterprise AI & Product Engineering"
  description="From product strategy and design to engineering and AI, we help teams build digital products that are clear, scalable, and ready for real-world use."
>
  <Nav slot="overlay" />

  <Hero />
  <KeyHighlights />
  <WhatWeDo />
  <WhatWeDoDark />
  <SelectedWork />
  <WhyNulyft />
  <OurProcess />
  <Technology />
  <Industries />
  <Clients />
  <CtaFooter />
</BaseLayout>

<script>
  import "../scripts/hero.ts";
  import "../scripts/reveal.ts";
  import "../scripts/anchors.ts";
  import "../scripts/tilt.ts";
  import "../scripts/phone-focus.ts";
  import "../scripts/why-orbit.ts";
  import "../scripts/process-scroll.ts";
  import "../scripts/tech-orbit.ts";
  import "../scripts/eng-pipeline.ts";
  import "../scripts/aidata-orbit.ts";
  import "../scripts/cloud-progress.ts";
  import "../scripts/industries.ts";
  import "../scripts/cta-fan.ts";
</script>
