---
import { Image } from "astro:assets";
import CaseHeader from "../case/CaseHeader.astro";
import PaletteFigure from "../case/PaletteFigure.astro";
import { typography, colorography } from "../../data/caseAuto";

/**
 * Typography and Colorography — Figma 510:5914 and 510:5964.
 *
 * Both bodies ship as one flattened export each rather than rebuilt DOM. The
 * type specimen is set in DM Sans, a face this site does not load and would
 * need five weights of for one decorative block; the palette figure is a
 * drawing whose six leader lines only line up at their drawn size. Same call
 * the LMS page made for its two figures — the meaning lives in `alt`.
*
 * The 100 is the container inset: it is the frame's padding, and an absolute
 * child resolves `top` against the border box, so it has to be added back.
 */
---

<section class="asys" data-section>
  <div class="asys__frame">
    <CaseHeader eyebrow={typography.eyebrow} title={typography.title} body={typography.intro} />

    <Image
      src={typography.figure.src}
      alt="DM Sans specimen in Light, Regular, Medium, Semibold and Bold, beside a Ready To Go Live dialog labelling its heading, body text and button label styles"
      width={typography.figure.w * 2}
      widths={[typography.figure.w, typography.figure.w * 2]}
      sizes={`${typography.figure.w}px`}
      class="asys__figure"
      style={`left:${typography.figure.x}px;top:calc(${typography.figure.y}px + var(--section-y));width:${typography.figure.w}px`}
      data-animate
    />

    <div class="asys__panels">
      {
        typography.split.map((panel) => (
          <Image
            src={panel.src}
            alt={panel.alt}
            width={panel.w * 2}
            widths={[panel.w, panel.w * 2]}
            sizes={`${panel.w}px`}
            class="asys__panel"
            data-animate
          />
        ))
      }
    </div>
  </div>
</section>

<section class="acol" data-section>
  <div class="acol__frame">
    <CaseHeader
      eyebrow={colorography.eyebrow}
      title={colorography.title}
      body={colorography.intro}
    />

    <PaletteFigure
      name={colorography.figure.name}
      width={colorography.figure.w}
      x={colorography.figure.x}
      alt={colorography.figure.alt}
    />
  </div>
</section>

<style>
  .asys,
  .acol {
    position: relative;
    background: var(--c-bg-light);
  }

  .asys__frame,
  .acol__frame {
    position: relative;
    width: 100%;
    max-width: 1240px;
    margin-inline: auto;
    padding-block: var(--section-y);
  }

  /* Drawn 795 and 758; the compositions end at 654 and 511. */
  .asys__frame {
    height: calc(654px + var(--section-y));
  }

  .acol__frame {
    height: calc(511px + var(--section-y));
  }

  /* Placed at the frame's own coordinates — these are drawn compositions, so
     they are positioned, not flowed. */
  .asys__figure {
    position: absolute;
    display: block;
    height: auto;
    max-width: none;
  }

  /* Phones get the same figure as two stacked panels — see the note on
     `typography.split` in `caseAuto.ts`. */
  .asys__panels {
    display: none;
  }

  .asys__panel {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 900px) {
    .asys__figure {
      display: none;
    }

    .asys__panels {
      display: flex;
      flex-direction: column;
      gap: 32px;
    }
  }

  @media (max-width: 1280px) {
    .asys__frame,
    .acol__frame {
      height: auto;
      padding-inline: var(--gutter);
    }

    .asys__figure {
      position: static;
      width: 100% !important;
      margin-top: 48px;
    }
  }

  .asys,
  .acol {
    overflow-x: clip;
  }

  @media (max-width: 900px) {
    .asys__frame,
  }

  /* Mobile */
  @media (max-width: 560px) {
    .asys__frame,
  }
</style>
