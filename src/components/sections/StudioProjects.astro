---
import Icon from "../ui/Icon.astro";
import ProjectCard from "../studio/ProjectCard.astro";
import TalentIntelligence from "./TalentIntelligence.astro";
import KeyHighlights from "./KeyHighlights.astro";
import { studioTabs, projectsByTab } from "../../data/studio";
import { highlights as talentStats } from "../../data/talent";

/**
 * Studio project grid with its filter tabs — Figma 493:2878.
 *
 * The Figma frame draws all eight cards under the first tab because it is a
 * "show everything" mock; the tabs are real filters, so each tab's grid is
 * derived from the data rather than copied off the frame. Cards flow in data
 * order, a `full` card takes a row of its own, and a leftover `half` sits
 * alone on the left — the pattern the frame's own last row uses.
 *
 * All four panels are rendered. With JS off, `html.no-js` shows every panel,
 * which lands back on exactly the frame Figma draws.
 *
 * Talent Intelligence is the odd one out: it has no case studies, and Figma
 * gives it a pitch instead — a split intro, a four-step process, and its own
 * stat band (501:3477). So a panel is either a project grid or a bespoke
 * section, and only the tab bar is shared.
 */
const panels = studioTabs.map((tab) => ({ tab, items: projectsByTab(tab.id) }));
---

<section class="projects" id="projects">
  <div class="container">
    <div class="projects__tabs" data-section>
      <div class="tabs" aria-label="Filter case studies by capability" data-animate data-tabs>
        {/* Mobile only. The four labels run ~984 wide, and a scrolling bar has
            no affordance and loses its swipe to ScrollSmoother — so below 900
            this button discloses the list instead, and `.tabs__row` becomes
            the menu. The tab buttons are reused as the options, so there is
            only one source of truth for which filter is on. */}
        <button
          type="button"
          class="tabs__toggle"
          data-tab-toggle
          aria-expanded="false"
          aria-haspopup="true"
        >
          <span class="tabs__toggle-label" data-tab-toggle-label>{studioTabs[0].label}</span>
          <Icon name="icons/chevron-down" size={20} class="tabs__chev" />
        </button>

        <div class="tabs__row" role="tablist">
          {
            studioTabs.map((tab, i) => (
              <button
                type="button"
                role="tab"
                id={`tab-${tab.id}`}
                class="tabs__tab"
                aria-controls={`panel-${tab.id}`}
                aria-selected={i === 0 ? "true" : "false"}
                tabindex={i === 0 ? 0 : -1}
                data-tab={tab.id}
              >
                {tab.label}
              </button>
            ))
          }
        </div>

        <div class="tabs__track">
          <span class="tabs__rule"></span>
          <span class="tabs__indicator" data-tab-indicator></span>
        </div>
      </div>
    </div>
  </div>

  <div class="projects__panels">
      {
        panels.map(({ tab, items }, i) => (
          <div
            role="tabpanel"
            id={`panel-${tab.id}`}
            class="projects__panel"
            aria-labelledby={`tab-${tab.id}`}
            data-panel={tab.id}
            hidden={i !== 0}
          >
            {tab.id === "talent" ? (
              <>
                <TalentIntelligence />
                <KeyHighlights
                  id="talent-highlights"
                  eyebrow={null}
                  title={talentStats.title}
                  body={talentStats.body}
                  stats={talentStats.stats}
                  gap={64}
                  size="md"
                />
              </>
            ) : items.length > 0 ? (
              <div class="container projects__grid">
                {items.map((project) => (
                  <ProjectCard project={project} />
                ))}
              </div>
            ) : (
              <div class="container">
                <p class="projects__empty">
                  We&rsquo;re putting the {tab.label} case studies together. Check back soon.
                </p>
              </div>
            )}
          </div>
        ))
      }
  </div>
</section>

<style>
  .projects {
    position: relative;
    padding-top: 100px;
    background: var(--c-bg-light);
  }

  /* The bottom pad belongs to the panel, not the section: a grid needs one,
     while the Talent panel ends on its own stat band which already has it. */
  .projects__panel:not([data-panel="talent"]) {
    padding-bottom: 100px;
  }

  /* --- tabs --------------------------------------------------------------- */

  .tabs {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .tabs__row {
    display: flex;
    gap: 64px;
    align-items: center;
  }

  /* The mobile disclosure trigger; the media query below turns it on. */
  .tabs__toggle {
    display: none;
  }

  .tabs__tab {
    flex: none;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--fs-md);
    line-height: 32px;
    letter-spacing: var(--tr-body);
    white-space: nowrap;
    color: var(--c-muted);
    background: none;
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .tabs__tab[aria-selected="true"] {
    color: var(--c-ink);
  }

  .tabs__tab:hover {
    color: var(--c-ink);
  }

  .tabs__track {
    position: relative;
    height: 4.8px;
  }

  .tabs__rule {
    position: absolute;
    top: 1px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--c-tab-rule);
  }

  /* Seeded with the first tab's Figma width so the first paint is right;
     `studio-tabs.ts` then measures the real text and keeps it honest. */
  .tabs__indicator {
    position: absolute;
    top: 0;
    left: 0;
    width: 284px;
    height: 5px;
    background: var(--c-accent);
    border-radius: 8px;
  }

  /* --- panels ------------------------------------------------------------- */

  .projects__panels {
    margin-top: 64px;
  }

  .projects__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 120px 16px;
    align-items: start;
  }

  .projects__empty {
    padding-block: 80px;
    font-size: var(--fs-md);
    line-height: var(--lh-card);
    letter-spacing: var(--tr-body);
    color: var(--c-muted);
  }

  /* With JS off there is nothing to drive the filter, so show every panel —
     which is the state the Figma frame draws. */
  :global(html.no-js) .projects__panel[hidden] {
    display: block;
  }

  /* --- responsive --------------------------------------------------------- */

  @media (max-width: 1240px) {
    .tabs__row {
      gap: 40px;
    }
  }

  @media (max-width: 900px) {
    .projects__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 64px;
    }

    /* The section kept its desktop 100px top padding and the panel its 100px
       bottom, so the hero sat 156 clear of the filter and the last card 140
       clear of the CTA. 40 is the block rhythm the home page's mobile frames
       use throughout. */
    .projects {
      padding-top: 40px;
    }

    /* Same selector as the base rule — `:not(...)` outranks a bare class, and
       a media query does not change that. */
    .projects__panel:not([data-panel="talent"]) {
      padding-bottom: 40px;
    }

    .projects__panels {
      margin-top: 32px;
    }

  }

  /* The tab row's natural width is 1032, and with the 100px gutters it only
     fits from about 1232 up — below that it overflowed its container and the
     page scrolled sideways at 1000 exactly as it did at 375. So the disclosure
     covers the whole range under the desktop layout, capped to a control's
     width rather than running the full column. */
  @media (max-width: 1240px) {
    /* ----------------------------------------------------------------------
       The four labels lay out ~984 wide. A scrolling bar carries no affordance
       and loses its horizontal swipe to ScrollSmoother's Observer, so this is
       a disclosure instead: the trigger shows the current filter and
       `.tabs__row` becomes the menu. The sliding indicator and its rule go —
       they could not have followed a scrolling row anyway.
       ---------------------------------------------------------------------- */
    /* The cards below open their own stacking contexts (reveal.ts leaves a
       transform on them), so the menu has to be lifted above the whole tab
       block, not just given a z-index inside it. */
    .projects__tabs {
      position: relative;
      z-index: 20;
    }

    .tabs {
      position: relative;
      gap: 0;
      overflow: visible;
    }

    .tabs__toggle {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      width: 100%;
      padding: 14px 16px;
      border: 1px solid var(--c-card-border);
      border-radius: 12px;
      background: var(--c-surface);
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 15px;
      line-height: 20px;
      text-align: left;
      color: var(--c-ink);
      cursor: pointer;
    }

    .tabs :global(.tabs__chev) {
      flex: none;
      color: var(--c-muted);
      transition: rotate var(--dur-fast) var(--ease-out);
    }

    .tabs[data-open] :global(.tabs__chev) {
      rotate: 180deg;
    }

    .tabs__track {
      display: none;
    }

    .tabs__row {
      position: absolute;
      z-index: 21;
      top: calc(100% + 6px);
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 2px;
      width: auto;
      padding: 6px;
      border: 1px solid var(--c-card-border);
      border-radius: 12px;
      background: var(--c-surface);
      box-shadow: 0 12px 32px rgba(24, 16, 43, 0.12);
    }

    .tabs__row:not([data-open]) {
      display: none;
    }

    .tabs__tab {
      width: 100%;
      padding: 12px;
      border-radius: 8px;
      font-size: 15px;
      line-height: 20px;
      text-align: left;
    }

    .tabs__tab[aria-selected="true"] {
      color: var(--c-accent);
      background: var(--c-accent-tint);
    }

    .tabs {
      max-width: 420px;
    }
  }

</style>

<script>
  import "../../scripts/studio-tabs";
</script>
