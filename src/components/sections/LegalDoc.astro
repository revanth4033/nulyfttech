---
import { company, type LegalBlock, type LegalDoc } from "../../data/legal";

/**
 * A long-form legal document — Privacy Policy, Terms & Conditions. No Figma
 * frame; built in the site's language: lavender ground, one white reading
 * card, numbered sections, and a table of contents on a rail (the Key
 * Features rail) that follows the reader and lights the section in view.
 *
 * The contents stay in view by a ScrollTrigger pin (`legal-toc.ts`) —
 * ScrollSmoother scrolls a transformed wrapper, where `position: sticky`
 * never engages. Under reduced motion there is no smoother, and the sticky
 * rule below does the same job natively.
 *
 * Below 1081 the rail gives way to an "On this page" disclosure above the
 * card.
 */
interface Props {
  doc: LegalDoc;
}

const { doc } = Astro.props;
const num = (i: number) => String(i + 1).padStart(2, "0");

/** What the supplied copy left as "[Insert …]" renders visibly until filled. */
const todo = (what: string) => `[Insert ${what}]`;
const contactRows = (kind: "privacy" | "terms") => [
  { label: "Registered office", value: company.registeredOffice, todo: "full registered office address" },
  kind === "privacy"
    ? { label: "Privacy contact email", value: company.privacyEmail, todo: "official privacy contact email", href: company.privacyEmail && `mailto:${company.privacyEmail}` }
    : { label: "Email", value: company.contactEmail, todo: "official company contact email", href: company.contactEmail && `mailto:${company.contactEmail}` },
  { label: "Website", value: company.website, todo: "production website URL", href: company.website && `https://${company.website}` },
  { label: "Company Identification Number (CIN)", value: company.cin, todo: "CIN, if appropriate for publication" },
];
/**
 * Splits running text into plain runs, `[[label|/href]]` links and
 * "[Insert …]" placeholders.
 */
type Run = { text: string; href?: string; todo?: boolean };
const runs = (text: string): Run[] => {
  const out: Run[] = [];
  const re = /\[\[([^|\]]+)\|([^\]]+)\]\]|(\[Insert [^\]]+\])/g;
  let at = 0;
  for (const m of text.matchAll(re)) {
    if (m.index! > at) out.push({ text: text.slice(at, m.index) });
    out.push(m[1] ? { text: m[1], href: m[2] } : { text: m[3], todo: true });
    at = m.index! + m[0].length;
  }
  if (at < text.length) out.push({ text: text.slice(at) });
  return out;
};

const dates = [
  { label: "Effective date", value: doc.effective },
  { label: "Last updated", value: doc.updated },
];
---

<section class="legal" data-section data-legal>
  <div class="container legal__inner">
    <aside class="legal__aside">
      <nav class="legal__toc" aria-label="On this page" data-legal-toc>
        <p class="legal__toc-label">On this page</p>
        <ol>
          {doc.sections.map((s, i) => (
            <li>
              <a href={`#${s.id}`}>
                <span class="legal__toc-num">{num(i)}</span>
                {s.title}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </aside>

    <details class="legal__toc-m" data-legal-toc-m>
      <summary>On this page</summary>
      <ol>
        {doc.sections.map((s, i) => (
          <li>
            <a href={`#${s.id}`}>
              <span class="legal__toc-num">{num(i)}</span>
              {s.title}
            </a>
          </li>
        ))}
      </ol>
    </details>

    <article class="legal__doc" data-legal-doc data-animate>
      <dl class="legal__dates">
        {dates.map((d) => (
          <div>
            <dt>{d.label}</dt>
            <dd class:list={{ legal__todo: !d.value }}>{d.value ?? todo("publication date")}</dd>
          </div>
        ))}
      </dl>

      {doc.sections.map((s, i) => (
        <section class="legal__sec" id={s.id} aria-labelledby={`${s.id}-title`}>
          <h2 class="legal__title" id={`${s.id}-title`}>
            <span class="legal__num">{num(i)}</span>
            {s.title}
          </h2>
          {s.body.map((b: LegalBlock) => (
            "p" in b ? <p class="legal__p">{runs(b.p).map((r) => r.href ? <a href={r.href}>{r.text}</a> : r.todo ? <span class="legal__todo">{r.text}</span> : r.text)}</p>
            : "list" in b ? (
              <ul class="legal__list">
                {b.list.map((item) =>
                  typeof item === "string"
                    ? <li>{item}</li>
                    : <li><strong>{item.lead}</strong> {item.text}</li>,
                )}
              </ul>
            )
            : (
              <div class="legal__contact">
                <p class="legal__contact-name">{company.name}</p>
                <dl>
                  {contactRows(b.contact).map((r) => (
                    <div>
                      <dt>{r.label}</dt>
                      <dd>
                        {r.value
                          ? (r.href ? <a href={r.href}>{r.value}</a> : r.value)
                          : <span class="legal__todo">{todo(r.todo)}</span>}
                      </dd>
                    </div>
                  ))}
                </dl>
              </div>
            )
          ))}

          {s.subs?.map((sub, j) => (
            <div class="legal__sub">
              <h3 class="legal__subtitle">
                <span class="legal__subnum">{i + 1}.{j + 1}</span>
                {sub.title}
              </h3>
              {sub.body.map((b: LegalBlock) => (
                "p" in b ? <p class="legal__p">{runs(b.p).map((r) => r.href ? <a href={r.href}>{r.text}</a> : r.todo ? <span class="legal__todo">{r.text}</span> : r.text)}</p>
                : "list" in b ? (
                  <ul class="legal__list">
                    {b.list.map((item) =>
                      typeof item === "string"
                        ? <li>{item}</li>
                        : <li><strong>{item.lead}</strong> {item.text}</li>,
                    )}
                  </ul>
                )
                : null
              ))}
            </div>
          ))}
        </section>
      ))}

      {doc.note && <p class="legal__note">{doc.note}</p>}
    </article>
  </div>
</section>

<style>
  .legal {
    position: relative;
    padding-block: var(--section-y);
    background: var(--c-bg-light);
  }

  .legal__inner {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    align-items: start;
    gap: 64px;
  }

  /* --- contents rail ------------------------------------------------------ */

  .legal__aside {
    align-self: stretch;
  }

  /* The smoother's pin replaces this; with no smoother (reduced motion) it
     is what keeps the contents in view. */
  .legal__toc {
    position: sticky;
    top: 144px;
  }

  /* With the smoother running, the pin moves it by transform; a live sticky
     offset on top of that doubled the gap under the nav. */
  :global(html.gsap-ready) .legal__toc {
    position: relative;
    top: auto;
  }

  .legal__toc-label,
  .legal__toc-m summary {
    font-size: var(--fs-xxs);
    font-weight: 600;
    line-height: 16px;
    color: var(--c-accent);
  }

  .legal__toc ol {
    margin-top: 16px;
    list-style: none;
    border-left: 2px solid var(--c-eyebrow-border);
  }

  .legal__toc a,
  .legal__toc-m a {
    display: flex;
    gap: 10px;
    padding: 6px 0 6px 16px;
    font-size: var(--fs-sm);
    line-height: 20px;
    color: var(--c-muted);
    text-decoration: none;
  }

  .legal__toc a {
    position: relative;
    margin-left: -2px;
    border-left: 2px solid transparent;
    transition:
      color var(--dur-fast) ease,
      border-color var(--dur-fast) ease;
  }

  .legal__toc-num {
    flex: none;
    width: 18px;
    font-variant-numeric: tabular-nums;
    color: var(--c-accent);
    opacity: 0.7;
  }

  .legal__toc a.is-active {
    border-left-color: var(--c-accent);
    font-weight: 500;
    color: var(--c-ink);
  }

  .legal__toc a.is-active .legal__toc-num {
    opacity: 1;
  }

  @media (hover: hover) and (pointer: fine) {
    .legal__toc a:hover,
    .legal__toc-m a:hover {
      color: var(--c-ink);
    }
  }

  .legal__toc-m {
    display: none;
  }

  /* --- the document ------------------------------------------------------- */

  .legal__doc {
    padding: 56px 64px 64px;
    border-radius: 16px;
    background: var(--c-surface);
    box-shadow:
      inset 0 0 0 1px var(--c-perk-border),
      var(--sh-card);
  }

  .legal__dates {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 40px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--c-rule);
  }

  .legal__dates dt,
  .legal__contact dt {
    font-size: var(--fs-xxs);
    line-height: 16px;
    letter-spacing: var(--tr-eyebrow-sm);
    text-transform: uppercase;
    color: var(--c-muted);
  }

  .legal__dates dd {
    margin-top: 4px;
    font-size: var(--fs-body);
    font-weight: 500;
    line-height: var(--lh-body);
    color: var(--c-ink);
  }

  .legal__sec {
    padding-top: 40px;
  }

  .legal__sec + .legal__sec {
    margin-top: 40px;
    border-top: 1px solid var(--c-rule);
  }

  .legal__title {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 20px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-lg);
    line-height: 32px;
    letter-spacing: -0.4px;
    color: var(--c-heading);
  }

  .legal__num {
    flex: none;
    font-size: var(--fs-body);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0;
    color: var(--c-accent);
  }

  .legal__sub {
    margin-top: 28px;
  }

  .legal__subtitle {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 12px;
    font-weight: 600;
    font-size: 18px;
    line-height: 26px;
    letter-spacing: var(--tr-card);
    color: var(--c-ink);
  }

  .legal__subnum {
    flex: none;
    font-size: var(--fs-sm);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--c-accent);
  }

  .legal__p,
  .legal__list li {
    font-size: var(--fs-body);
    line-height: 26px;
    letter-spacing: var(--tr-body);
    color: var(--c-muted);
  }

  .legal__p + .legal__p,
  .legal__list + .legal__p,
  .legal__p + .legal__list,
  .legal__list + .legal__contact,
  .legal__p + .legal__contact,
  .legal__contact + .legal__p {
    margin-top: 16px;
  }

  .legal__list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    list-style: none;
  }

  .legal__list li {
    position: relative;
    padding-left: 24px;
  }

  /* The accent diamond the case studies use for their module lists. */
  .legal__list li::before {
    content: "";
    position: absolute;
    left: 4px;
    top: 10px;
    width: 7px;
    height: 7px;
    rotate: 45deg;
    background: var(--c-accent);
  }

  .legal__list strong {
    font-weight: 600;
    color: var(--c-ink);
  }

  .legal__contact {
    padding: 24px 28px;
    border-radius: var(--r-card);
    background: var(--c-bg-light);
    box-shadow: inset 0 0 0 1px var(--c-eyebrow-border);
  }

  .legal__contact-name {
    font-weight: 600;
    font-size: 18px;
    line-height: 26px;
    color: var(--c-ink);
  }

  .legal__contact dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 32px;
    margin-top: 20px;
  }

  .legal__contact dd {
    margin-top: 4px;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--c-ink);
    overflow-wrap: anywhere;
  }

  .legal__contact a,
  .legal__p a {
    color: var(--c-accent);
    text-underline-offset: 3px;
  }

  /* A detail still to be supplied — visible on purpose so it is not missed. */
  .legal__todo {
    color: var(--c-muted);
    font-style: italic;
  }

  .legal__note {
    margin-top: 48px;
    padding: 16px 20px;
    border-left: 3px solid var(--c-accent);
    border-radius: 0 var(--r-card) var(--r-card) 0;
    background: var(--c-eyebrow-bg);
    font-size: var(--fs-sm);
    font-style: italic;
    line-height: 22px;
    color: var(--c-ink);
  }

  /* --- tablet and phone ---------------------------------------------------- */

  @media (max-width: 1280px) {
    .legal__inner {
      grid-template-columns: 240px minmax(0, 1fr);
      gap: 48px;
    }

    .legal__doc {
      padding: 48px;
    }
  }

  @media (max-width: 1080px) {
    .legal__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }

    .legal__aside {
      display: none;
    }

    .legal__toc-m {
      display: block;
      border-radius: var(--r-card);
      background: var(--c-surface);
      box-shadow: inset 0 0 0 1px var(--c-perk-border);
    }

    .legal__toc-m summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 20px;
      cursor: pointer;
      list-style: none;
    }

    .legal__toc-m summary::-webkit-details-marker {
      display: none;
    }

    /* A chevron that turns as the list opens. */
    .legal__toc-m summary::after {
      content: "";
      width: 8px;
      height: 8px;
      margin-top: -4px;
      border-right: 2px solid currentColor;
      border-bottom: 2px solid currentColor;
      rotate: 45deg;
      transition: rotate var(--dur-fast) ease, margin var(--dur-fast) ease;
    }

    .legal__toc-m[open] summary::after {
      margin-top: 4px;
      rotate: -135deg;
    }

    .legal__toc-m ol {
      padding: 0 20px 12px 4px;
      list-style: none;
    }
  }

  @media (max-width: 900px) {
    .legal__doc {
      padding: 40px 32px;
    }
  }

  @media (max-width: 560px) {
    .legal__doc {
      padding: 28px 20px 32px;
    }

    .legal__dates {
      padding-bottom: 24px;
    }

    .legal__sec {
      padding-top: 32px;
    }

    .legal__sec + .legal__sec {
      margin-top: 32px;
    }

    .legal__title {
      gap: 10px;
      margin-bottom: 16px;
      font-size: var(--fs-md);
      line-height: 28px;
      letter-spacing: -0.2px;
    }

    .legal__num {
      font-size: var(--fs-sm);
    }

    .legal__subtitle {
      font-size: var(--fs-body);
      line-height: 24px;
    }

    .legal__p,
    .legal__list li {
      font-size: 15px;
      line-height: 24px;
    }

    .legal__list li::before {
      top: 9px;
    }

    .legal__contact {
      padding: 20px;
    }

    .legal__contact dl {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }
  }
</style>
