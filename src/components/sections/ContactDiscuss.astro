---
import { Image } from "astro:assets";
import PillButton from "../ui/PillButton.astro";
import curves from "../../assets/images/contact/abstract-curves.png";
import { discuss } from "../../data/contact";

/**
 * "Let's discuss your use-case together" — Figma 672:3835, 1440 x 589.
 *
 * Copy and a button beside an abstract curves illustration, 147 apart. The
 * frame also holds the six vertical grid rules every light band uses, but
 * hidden, so they are left out. "Book a Call" scrolls to the form below.
 *
 * The illustration is a 2x raster of Figma's 14-path vector over the
 * section's ground, cropped to its visible curves (it carried ~50px of empty
 * ground above and below, which doubled the gaps around this section) — see ContactForm for why this page avoids live SVG art.
 */
---

<section class="discuss" data-section="contact-discuss">
  <div class="discuss__inner container">
    <div class="discuss__copy">
      <h2 class="discuss__title" data-animate>{discuss.title}</h2>
      <p class="discuss__body" data-animate>{discuss.body}</p>
      <div class="discuss__cta" data-animate>
        <PillButton href={discuss.cta.href} flat arrow={20}>{discuss.cta.label}</PillButton>
      </div>
    </div>

    <Image
      class="discuss__art"
      src={curves}
      alt=""
      widths={[448, 896]}
      sizes="(max-width: 1180px) 360px, 448px"
      aria-hidden="true"
      data-animate
    />
  </div>
</section>

<style>
  .discuss {
    background: var(--c-bg-light);
    padding-block: var(--section-y);
  }

  .discuss__inner {
    display: flex;
    align-items: center;
    gap: 147px;
  }

  .discuss__copy {
    flex: 0 1 600px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .discuss__title {
    max-width: 484px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-hero);
    line-height: normal;
    letter-spacing: var(--tr-h2);
    color: var(--c-ink);
    /* Figma breaks after "use -"; balance would even the two lines out. */
    text-wrap: wrap;
  }

  .discuss__body {
    max-width: 558px;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--c-muted);
  }

  /* The pill's rotated box is 146.76 x 49.66. */
  .discuss__cta {
    display: flex;
    align-items: center;
    height: 49.662px;
  }

  /* The raster carries the section's ground baked in, and WebP lifts that
     plate a level above the real ground — enough for its box to show once
     the picture sits in open space on a tablet. `darken` keeps whichever is
     darker per pixel: the ground wherever the plate is, the curves (always
     darker than the ground) everywhere else. */
  .discuss :global(.discuss__art) {
    flex: none;
    width: 448px;
    height: 327px;
    mix-blend-mode: darken;
  }

  /* --- narrower than the design ------------------------------------------ */

  /* 600 + 147 + 448 only fits the design's column; at 1024 the copy was
     left 229px. The gap closes and the illustration (a picture, so it
     scales) steps down before anything stacks. */
  @media (max-width: 1180px) {
    .discuss__inner {
      gap: 64px;
    }

    .discuss :global(.discuss__art) {
      width: 360px;
      height: auto;
      aspect-ratio: 448 / 327;
    }

    .discuss__title {
      font-size: 40px;
      letter-spacing: -1.4px;
    }
  }

  @media (max-width: 1000px) {
    .discuss :global(.discuss__art) {
      width: 300px;
    }
  }

  /* Stacked: the copy, then the curves centred under it, smaller — they are
     an ornament here, not a column. */
  @media (max-width: 900px) {

    .discuss__inner {
      flex-direction: column;
      align-items: stretch;
      gap: 40px;
    }

    .discuss__copy {
      flex: none;
    }

    .discuss__title {
      max-width: 560px;
      font-size: 34px;
      letter-spacing: -1px;
    }

    .discuss :global(.discuss__art) {
      align-self: center;
      width: min(100%, 320px);
    }
  }

  @media (max-width: 560px) {

    .discuss__inner {
      gap: 32px;
    }

    .discuss__copy {
      gap: 12px;
    }

    .discuss__title {
      font-size: 28px;
      line-height: 1.2;
      letter-spacing: -0.6px;
    }

    .discuss__body {
      font-size: var(--fs-sm);
      line-height: 22px;
    }

    .discuss__cta {
      margin-top: 8px;
    }

    .discuss :global(.discuss__art) {
      width: min(100%, 260px);
    }
  }

  /* The lowest ~36px of the curves fade to almost nothing; let the section
     close on the visible strokes. */
  @media (min-width: 901px) {
    .discuss :global(.discuss__art) {
      margin-bottom: -36px;
    }
  }

  /* Stacked, the same faint foot of the curves: ~27px at tablet, ~20 on a
     phone. */
  @media (max-width: 900px) {
    .discuss :global(.discuss__art) {
      margin-bottom: -27px;
    }
  }

  @media (max-width: 560px) {
    .discuss :global(.discuss__art) {
      margin-bottom: -20px;
    }
  }
</style>
