---
import HeroBackdrop from "../ui/HeroBackdrop.astro";
import EyebrowBadge from "../ui/EyebrowBadge.astro";

/**
 * The redesign's centred inner-page hero — Studio (667:3303) and About Us
 * (669:3595) draw the same 1440 x 600 frame and differ only in copy. Careers
 * uses it too, by request, with its existing copy (there is no redesigned
 * Careers frame).
 *
 * The home hero's ground (`HeroBackdrop`, its `page` clouds) under one
 * centred 728-wide column: badge, headline with an italic tail, and a
 * paragraph. Figma centres the column on the frame, which puts its top at 200.
 *
 * Contact Us (672:3796) draws it shorter — 554 — with the copy 29.8 below
 * centre and no italic tail, hence `height`, `offset` and an optional `em`.
 */
interface Props {
  eyebrow: string;
  title: { lead: string; em?: string };
  /** One entry per line Figma breaks by hand. */
  body: string[];
  height?: number;
  /** How far below the frame's centre the copy column sits. */
  offset?: number;
}

const { eyebrow, title, body, height = 600, offset = -0.2 } = Astro.props;
---

<section class="phead" data-section="page-hero" style={`--phead-h:${height}px;--phead-dy:${offset}px`}>
  <HeroBackdrop variant="page" />

  <div class="phead__copy">
    <div class="phead__head">
      <EyebrowBadge variant="studio" data-animate>{eyebrow}</EyebrowBadge>
      <h1 class="phead__title" data-animate>
        {title.lead}{title.em && <em>{title.em}</em>}
      </h1>
    </div>
    <p class="phead__body" data-animate>
      {body.map((line, i) => (i === 0 ? line : [<br />, " ", line]))}
    </p>
  </div>
</section>

<style>
  .phead {
    position: relative;
    height: var(--phead-h);
    overflow: hidden;
    background: var(--c-bg-light);
  }

  .phead__copy {
    position: absolute;
    z-index: var(--z-content);
    left: 50%;
    top: calc(50% + var(--phead-dy));
    translate: -50% -50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    width: min(728px, calc(100% - 2 * var(--gutter)));
    text-align: center;
  }

  .phead__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .phead__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-hero);
    line-height: normal;
    letter-spacing: var(--tr-hero-studio);
    color: var(--c-ink);
  }

  .phead__title em {
    /* Set upright at full weight, like the rest of the headline (by
       request — the frame sets this tail italic). */
    font-style: normal;
  }

  .phead__body {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    letter-spacing: var(--tr-body);
    color: var(--c-muted);
  }

  /* --- tablet and phone -------------------------------------------------- */

  /* The frame is a fixed height with the copy centred in it; narrower, the
     copy grows taller than the frame allows for under the nav, so the hero
     sizes to its copy instead. The copy joins the flow — and a block that
     leaves `position: absolute` keeps its `translate`, which would drag it
     half its width off the left edge, so that is reset too. It stays
     `relative` so it still paints over the backdrop.

     Figma's hand-set line breaks are for a 728 column; in a narrow one they
     strand a word or two on a line, so they give way to normal wrapping (the
     space after each break keeps the words apart; at desktop a space at the
     start of a line collapses, so the frame is untouched). */
  @media (max-width: 900px) {
    .phead {
      height: auto;
      padding: calc(var(--nav-top) + var(--nav-card-h) + 72px) 0 80px;
    }

    .phead__copy {
      position: relative;
      left: auto;
      top: auto;
      translate: none;
      margin-inline: auto;
    }

    .phead__title {
      font-size: 40px;
      letter-spacing: -1.4px;
    }

    .phead__body br {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .phead {
      padding: calc(var(--nav-top) + var(--nav-card-h) + 48px) 0 56px;
    }

    .phead__copy {
      gap: 12px;
    }

    .phead__title {
      font-size: 30px;
      line-height: 1.2;
      letter-spacing: -0.8px;
    }

    .phead__body {
      font-size: var(--fs-sm);
      line-height: 22px;
    }
  }
</style>
