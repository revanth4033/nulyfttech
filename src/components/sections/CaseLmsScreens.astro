---
import { Image } from "astro:assets";
import CaseHeader from "../case/CaseHeader.astro";
import { screens } from "../../data/caseLms";

/**
 * UI Screens — Figma 505:4788.
 *
 * Five blocks. Two are captioned — screenshot on one side, title and copy on
 * the other, mirrored between them — and three run the full column width.
 * `layout` in the data decides which, so adding a screen is a data change.
 *
 * Each block reserves its Figma node's box and lets the export's baked shadow
 * overflow it. The exports run 53-84px larger per side here, and sizing the
 * blocks to them instead put this section 293px over the frame.
 */

/** The frame's column for each layout: the full 1240, or one grid cell. */
const cellOf = (layout: string) => (layout === "full" ? 1240 : 608);
---

<section class="scr" data-section>
  <div class="container scr__inner">
    <CaseHeader eyebrow={screens.eyebrow} title={screens.title} body={screens.body} />

    <div class="scr__blocks">
      {
        screens.blocks.map((block) => (
          <div class:list={["shot", `shot--${block.layout}`]} data-animate>
            <figure
              class="shot__media"
              style={`width:${(block.node.w / cellOf(block.layout)) * 100}%;aspect-ratio:${block.node.w}/${block.node.h}`}
            >
              <Image
                src={block.src}
                alt={block.alt}
                width={Math.round(block.exp.w * 2)}
                widths={[Math.round(block.exp.w), Math.round(block.exp.w * 2)]}
                sizes={`${Math.round(block.exp.w)}px`}
                style={`width:${(block.exp.w / block.node.w) * 100}%;left:${(block.off.x / block.node.w) * 100}%;top:${(block.off.y / block.node.h) * 100}%`}
              />
            </figure>

            {block.title && (
              <div class="shot__copy">
                <h3>{block.title}</h3>
                <p>{block.body}</p>
              </div>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .scr {
    position: relative;
    background: var(--c-bg-light);
  }

  .scr__inner {
    display: flex;
    flex-direction: column;
    gap: 64px;
    padding-block: var(--section-y);
  }

  .scr__blocks {
    display: flex;
    flex-direction: column;
    gap: 120px;
  }

  /* The figure reserves the Figma node's box; the export is larger by its
     baked shadow and hangs outside it, placed from `off` in the data. The
     shadow is not centred — it runs ~29px above the card and ~93 below — so
     centring the export is no more correct than sizing the figure to it. */
  .shot__media {
    position: relative;
  }

  .shot__media :global(img) {
    position: absolute;
    display: block;
    height: auto;
    max-width: none;
  }

  /* --- captioned blocks ------------------------------------------------------ */

  .shot--left,
  .shot--right {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    align-items: center;
  }

  /* `right` puts the screenshot on the right, so the copy takes column one. */
  .shot--right .shot__media {
    order: 2;
  }

  .shot__copy {
    /* Above the screenshots beside it: their baked drop shadow (~60px a
       side) overhangs this column and painted over the first words. */
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .shot__copy h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-lg);
    line-height: 1.3;
    letter-spacing: var(--tr-project-title);
    color: var(--c-accent);
  }

  .shot__copy p {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--c-muted);
  }

  @media (max-width: 900px) {
    .scr__blocks {
      gap: 72px;
    }

    .shot--left,
    .shot--right {
      grid-template-columns: 1fr;
    }

    .shot--right .shot__media {
      order: 0;
    }
  }

  /* Same as Approach: the exports run 53-84px past their node box by design,
     which is wider than the column on a phone. */
  .scr {
    overflow-x: clip;
  }

  @media (max-width: 900px) {

    .shot__copy h3 {
      font-size: 20px;
      line-height: 28px;
    }

    .shot__copy p {
      font-size: 15px;
      line-height: 24px;
    }
  }

  /* Mobile */
  @media (max-width: 560px) {
    .scr__inner {
      gap: 32px;
    }

    .scr__blocks {
      gap: 48px;
    }

    .shot__copy h3 {
      font-size: 18px;
      line-height: 26px;
    }

    .shot__copy p {
      font-size: 14px;
      line-height: 22px;
    }
  }

  /* The last screenshot hangs 13px into the foot. */
  @media (min-width: 1241px) {
    .scr__inner {
      padding-bottom: calc(var(--section-y) + 13px);
    }
  }
</style>
