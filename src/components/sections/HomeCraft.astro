---
import { Image } from "astro:assets";
import Icon from "../ui/Icon.astro";
import GridLines from "../ui/GridLines.astro";
import PillButton from "../ui/PillButton.astro";
import team from "../../assets/images/home/craft-team.jpg";
import { craft } from "../../data/home";

/**
 * "Great products don't happen by accident" — Figma 664:3065, 1440 x 796.
 *
 * Three service cards in a 509 column beside a 702 one holding a belief card
 * over a photo with a frosted caption. The background rules are Figma's
 * 0.5px #232323 at 0.144 opacity, drawn here at 1px and half that.
 */
---

<section class="craft" data-section="home-craft">
  <GridLines stroke="rgba(35, 35, 35, 0.072)" />

  <div class="craft__inner container">
    <h2 class="craft__title" data-animate>{craft.title}</h2>

    <div class="craft__grid">
      <ul class="craft__services">
        {
          craft.services.map((s) => (
            <li class="craft__card craft__service" data-animate>
              <span class="craft__chip">
                <Icon name={s.icon} size={32} />
              </span>
              <div class="craft__service-text">
                <h3 class="craft__card-title">{s.title}</h3>
                <p class="craft__card-body">{s.body}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="craft__side">
        <div class="craft__card craft__belief" data-animate>
          <h3 class="craft__card-title">{craft.belief.title}</h3>
          <p class="craft__card-body">{craft.belief.body}</p>
          <ul class="craft__points">
            {
              craft.belief.points.map((p) => (
                <li>
                  <Icon name="icons/home/circle-check" size={20} />
                  {p}
                </li>
              ))
            }
          </ul>
        </div>

        <figure class="craft__photo" data-animate>
          <Image src={team} alt={craft.photo.alt} widths={[702, 1404]} sizes="702px" />
          <figcaption class="craft__caption">
            <span class="craft__caption-copy">
              <span class="craft__eyebrow">{craft.photo.eyebrow}</span>
              <span class="craft__caption-title">{craft.photo.title}</span>
            </span>
            <PillButton
              href={craft.photo.cta.href}
              variant="outline"
              arrow={20}
              arrowIcon="icons/arrow-circle-20-outline"
              class="craft__cta"
            >
              {craft.photo.cta.label}
            </PillButton>
          </figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>

<style>
  .craft {
    position: relative;
    overflow: hidden;
    background: var(--c-bg-light);
    padding-block: var(--section-y);
  }

  .craft__inner {
    position: relative;
    z-index: var(--z-content);
    display: flex;
    flex-direction: column;
    gap: 64px;
  }

  .craft__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-h3);
    line-height: normal;
    letter-spacing: var(--tr-h2);
    color: var(--c-heading);
  }

  .craft__grid {
    display: flex;
    align-items: flex-start;
    gap: 29px;
  }

  /* --- cards ------------------------------------------------------------- */

  .craft__card {
    background: var(--c-surface);
    border: 1px solid rgba(131, 77, 251, 0.24);
    border-radius: var(--r-card);
    padding: 20px;
  }

  /* Hover (by request): the card takes a light brand tint. It has to be a
     step deeper than the section's own #f5f3ff ground or the card would melt
     into it, so the border deepens with it; the icon chip — itself a tint —
     turns white to keep the icon standing off the card. Fine pointers only,
     so a tap never leaves a card tinted. */
  /* 0.6s on an even ease-in-out: the site's --ease-out front-loads the
     change (60% of it in the first 50ms), which read as an instant snap. */
  .craft__card,
  .craft__chip {
    transition:
      background-color 0.6s cubic-bezier(0.4, 0, 0.2, 1),
      border-color 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    .craft__card:hover {
      background-color: #efe8ff;
      border-color: rgba(131, 77, 251, 0.45);
    }

    .craft__card:hover .craft__chip {
      background-color: var(--c-surface);
    }
  }

  .craft__card-title {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 18px;
    line-height: 22px;
    color: #000;
    white-space: nowrap;
  }

  .craft__card-body {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    letter-spacing: var(--tr-body);
    color: var(--c-muted);
    /* Hand back the -0.16 CSS reserves after the last glyph: "...help
       businesses make" measures 391.13 in a 391 column and otherwise drops
       "make" a line, where Figma keeps it. */
    margin-right: var(--tr-body);
  }

  .craft__services {
    flex: 0 0 509px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    list-style: none;
  }

  .craft__service {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .craft__chip {
    flex: none;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 12px;
    background: var(--c-accent-tint);
    color: var(--c-accent);
    line-height: 0;
  }

  .craft__service-text {
    flex: 1 0 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* --- right column ------------------------------------------------------ */

  .craft__side {
    flex: 1 0 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
    height: 480px;
  }

  .craft__belief {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .craft__points {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    list-style: none;
  }

  .craft__points li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 500;
    font-size: var(--fs-sm);
    line-height: 20px;
    letter-spacing: var(--tr-card);
    color: var(--c-ink);
    white-space: nowrap;
  }

  .craft__points :global(.icon) {
    color: var(--c-accent);
    line-height: 0;
  }

  .craft__photo {
    position: relative;
    flex: 1 0 0;
    min-height: 0;
    overflow: hidden;
    border-radius: var(--r-card);
  }

  .craft__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* 357 in from the photo's left, centred 33.5 below its middle. */
  .craft__caption {
    position: absolute;
    left: 357px;
    top: calc(50% + 33.5px);
    translate: 0 -50%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 24px;
    height: 177px;
    padding: 24px;
    border-radius: var(--r-card);
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(13.8px);
  }

  .craft__caption-copy {
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-weight: 500;
    line-height: normal;
    white-space: nowrap;
  }

  .craft__eyebrow {
    font-size: var(--fs-sm);
    letter-spacing: var(--tr-eyebrow-sm);
    text-transform: uppercase;
    color: var(--c-accent);
  }

  .craft__caption-title {
    font-size: var(--fs-md);
    color: #000;
  }

  /* Figma pads this pill 12px top and bottom rather than fixing it at 48. */
  .craft :global(.craft__cta) {
    align-self: flex-start;
    height: auto;
    padding-block: 12px;
  }

  /* --- narrower than the design ------------------------------------------ */

  /* 1181-1439: both columns give way rather than overflow. The caption was
     placed 357 from the photo's left, which only holds while the photo is
     702 wide — at 1280 it ran off the card — so it anchors right instead;
     the belief title may wrap. */
  @media (max-width: 1439px) {
    .craft__services {
      flex: 0 1 509px;
      min-width: 0;
    }

    .craft__belief .craft__card-title {
      white-space: normal;
    }

    .craft__caption {
      left: auto;
      right: 24px;
    }
  }

  /* --- tablet ------------------------------------------------------------ */

  /* The two columns stack: the three services become a row of three upright
     cards (icon over text), then the belief card, then the photo — with its
     caption still over the photo's right side, as drawn, since a tablet
     photo has the room. */
  @media (max-width: 1180px) {
    .craft__grid {
      flex-direction: column;
      align-items: stretch;
      gap: 24px;
    }

    .craft__services {
      flex: none;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }

    .craft__service {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }

    .craft__service-text {
      flex: none;
    }

    .craft__card-title {
      white-space: normal;
    }

    .craft__side {
      flex: none;
      height: auto;
    }

    .craft__photo {
      flex: none;
      aspect-ratio: 16 / 9;
    }
  }

  @media (max-width: 900px) {

    .craft__inner {
      gap: 32px;
    }

    .craft__title {
      font-size: 28px;
      letter-spacing: -1px;
    }

    /* One service per row, icon beside the text: three upright cards in a
       768 column were 210 wide with seven-line bodies. */
    .craft__services {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }

    .craft__service {
      flex-direction: row;
      align-items: flex-start;
      gap: 16px;
      padding: 16px;
    }

    .craft__service-text {
      flex: 1 0 0;
      min-width: 0;
      gap: 6px;
    }

    .craft__chip {
      width: 48px;
      height: 48px;
      border-radius: 10px;
    }

    /* Size the icon's box, not just the drawing: shrinking only the svg
       left it in the top-left of its box, off centre in the chip. */
    .craft__chip :global(.icon) {
      width: 26px;
      height: 26px;
    }

    .craft__card-title {
      font-size: var(--fs-body);
      line-height: 22px;
    }

    .craft__card-body {
      font-size: var(--fs-sm);
      line-height: 22px;
    }
  }

  /* --- phone ------------------------------------------------------------- */

  /* The caption leaves the photo:
     on a 343px picture a 177-tall frosted card would cover most of it, so
     it becomes the photo's own footer — same copy and button, no overlap. */
  @media (max-width: 700px) {
    .craft__belief {
      gap: 12px;
      padding: 16px;
    }

    .craft__points {
      flex-direction: column;
      gap: 10px;
    }

    .craft__photo {
      display: flex;
      flex-direction: column;
      aspect-ratio: auto;
      background: var(--c-surface);
      border: 1px solid rgba(131, 77, 251, 0.24);
    }

    .craft__photo :global(img) {
      height: auto;
      aspect-ratio: 4 / 3;
    }

    .craft__caption {
      position: static;
      translate: none;
      height: auto;
      gap: 16px;
      padding: 16px;
      border-radius: 0;
      background: none;
      backdrop-filter: none;
    }

    .craft__caption-copy {
      gap: 6px;
      white-space: normal;
    }

    .craft__eyebrow {
      font-size: var(--fs-xs);
    }

    .craft__caption-title {
      font-size: 18px;
    }
  }

  @media (max-width: 560px) {

    .craft__title {
      font-size: 24px;
      letter-spacing: -0.6px;
    }
  }
</style>
