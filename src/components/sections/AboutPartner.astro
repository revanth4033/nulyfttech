---
import { Image } from "astro:assets";
import Icon from "../ui/Icon.astro";
import PillButton from "../ui/PillButton.astro";
import photo from "../../assets/images/about/team-review.jpg";
import { partner } from "../../data/about";

/**
 * "More than a project. A technology partner" — Figma 669:3672, 1440 x 719.
 *
 * A 400 x 519 photo with a captioned dark fade beside the pitch: heading,
 * two paragraphs, a button, and three cards. Each card's tag is tilted
 * -0.65deg like every pill on the site — Figma rotates the label, not the
 * row, so the shield stays level.
 */
---

<section class="partner" data-section="about-partner">
  <div class="partner__inner container">
    <figure class="partner__photo" data-animate>
      <Image src={photo} alt={partner.photo.alt} widths={[400, 800]} sizes="400px" />
      <figcaption class="partner__caption">
        <Icon name="icons/about/star-badge" size={24} />
        {partner.photo.caption}
      </figcaption>
    </figure>

    <div class="partner__copy">
      <div class="partner__lead">
        <div class="partner__text">
          <h2 class="partner__title" data-animate>{partner.title}</h2>
          <div class="partner__body" data-animate>
            {partner.body.map((p) => <p>{p}</p>)}
          </div>
        </div>
        <div class="partner__cta" data-animate>
          <PillButton href={partner.cta.href} flat arrow={20}>{partner.cta.label}</PillButton>
        </div>
      </div>

      <ul class="partner__cards">
        {
          partner.cards.map((c) => (
            <li class="partner__card" data-animate>
              <div class="partner__card-head">
                <span class="partner__tag">
                  <Icon name="icons/about/shield-check" size={20} />
                  <span class="partner__tag-label">{c.tag}</span>
                </span>
                <h3 class="partner__card-title">{c.title}</h3>
              </div>
              <p class="partner__card-body">{c.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .partner {
    background: var(--c-bg-light);
    padding-block: 100px 100.03px;
  }

  .partner__inner {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  /* --- photo ------------------------------------------------------------- */

  .partner__photo {
    position: relative;
    flex: none;
    width: 400px;
    height: 518.97px;
    overflow: hidden;
    border-radius: 16px;
  }

  .partner__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .partner__photo::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 49.906%, rgba(0, 0, 0, 0.9));
  }

  .partner__caption {
    position: absolute;
    z-index: 1;
    left: calc(50% - 5px);
    top: 471px;
    translate: -50% 0;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: #fff;
    white-space: nowrap;
  }

  /* --- copy -------------------------------------------------------------- */

  .partner__copy {
    flex: 1 0 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .partner__lead {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 40px;
  }

  .partner__text {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .partner__title {
    max-width: 732px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-h2);
    line-height: normal;
    letter-spacing: var(--tr-h2);
    color: var(--c-ink);
  }

  .partner__body {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--c-muted);
  }

  /* The pill's rotated box is 210.76 x 50.39; the gaps are measured to it. */
  .partner__cta {
    display: flex;
    align-items: center;
    height: 50.391px;
  }

  /* --- cards ------------------------------------------------------------- */

  .partner__cards {
    display: flex;
    gap: 16px;
    list-style: none;
  }

  .partner__card {
    flex: 1 0 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 56px;
    padding: 24px;
    background: var(--c-surface);
    border: 1px solid rgba(131, 77, 251, 0.24);
    border-radius: 16px;
  }

  .partner__card-head {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  /* 21.58 is the tilted label's bounding box, which is what Figma sizes the
     row by. */
  .partner__tag {
    display: flex;
    align-items: center;
    gap: 6px;
    min-height: 21.58px;
    color: var(--c-accent);
    line-height: 0;
  }

  .partner__tag-label {
    font-weight: 500;
    font-size: var(--fs-xxs);
    line-height: var(--lh-button);
    white-space: nowrap;
    rotate: var(--tilt);
  }

  .partner__card-title {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 18px;
    line-height: 24px;
    letter-spacing: var(--tr-project-title);
    color: var(--c-ink);
    white-space: nowrap;
  }

  .partner__card-body {
    padding-top: 24px;
    border-top: 1px solid rgba(131, 77, 251, 0.24);
    font-size: var(--fs-sm);
    line-height: 20px;
    color: var(--c-muted);
  }
</style>
