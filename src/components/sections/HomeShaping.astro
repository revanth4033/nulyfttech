---
import Icon from "../ui/Icon.astro";
import PillButton from "../ui/PillButton.astro";
import { shaping, orbitDots } from "../../data/home";

/**
 * "Shaping what businesses can do with technology" — Figma 664:3173 ("Work"),
 * 1440 x 568.
 *
 * Copy on the left, the "Possibility into Progress" disc in its orbit in the
 * middle, and three steps on the right set in a zig-zag: the middle one is
 * pushed to the column's right edge. The orbit is a 291 x 295 composition —
 * two rings, an open arc and nine dots — placed at Figma's coordinates.
 */
const px = (n: number) => `${n}px`;
---

<section class="shape" data-section="home-shaping">
  <div class="shape__inner container">
    <div class="shape__copy">
      <div class="shape__text">
        <h2 class="shape__title" data-animate>{shaping.title}</h2>
        <p class="shape__body" data-animate>{shaping.body}</p>
      </div>
      <div class="shape__cta" data-animate>
        <PillButton href={shaping.cta.href} variant="outline" arrow={20} arrowIcon="icons/arrow-circle-20-outline">
          {shaping.cta.label}
        </PillButton>
      </div>
    </div>

    <div class="shape__orbit" data-animate>
      <span class="shape__ring" aria-hidden="true"></span>
      <span class="shape__line shape__line--arc" aria-hidden="true">
        <Icon name="brand/home/orbit-segment" width={210.73} height={229.8} />
      </span>
      <span class="shape__line shape__line--inner" aria-hidden="true">
        <Icon name="brand/home/inner-orbit" width={191} height={192} />
      </span>
      {
        orbitDots.map((d) => (
          <span
            class="shape__dot"
            style={`left:${px(d.x)};top:${px(d.y)};width:${px(d.s)};height:${px(d.s)};background:${d.c}`}
            aria-hidden="true"
          />
        ))
      }
      <p class="shape__core">
        <span class="shape__core-lead">{shaping.core.lead}</span>
        <span class="shape__core-title">{shaping.core.title}</span>
      </p>
    </div>

    <ol class="shape__steps">
      {
        shaping.steps.map((s) => (
          <li
            class:list={["shape__step", `shape__step--${s.align}`]}
            style={`top:${px(s.y)};width:${px(s.w)}`}
            data-animate
          >
            <span class="shape__icon">
              <Icon name={s.icon} size={28} />
            </span>
            <span class="shape__step-text">
              <h3 class="shape__step-title">{s.title}</h3>
              <p class="shape__step-body">{s.body}</p>
            </span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .shape {
    background: var(--c-bg-light);
    padding-block: 100px;
  }

  .shape__inner {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  /* --- copy -------------------------------------------------------------- */

  .shape__copy {
    flex: 0 0 439px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 32px;
  }

  .shape__text {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .shape__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-h2);
    line-height: normal;
    letter-spacing: var(--tr-h2);
    text-transform: capitalize;
    color: var(--c-ink);
  }

  .shape__body {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--c-muted);
  }

  .shape__cta {
    display: flex;
    align-items: center;
    height: 50.232px;
  }

  /* --- orbit ------------------------------------------------------------- */

  .shape__orbit {
    position: relative;
    flex: none;
    width: 291px;
    height: 295px;
  }

  .shape__ring {
    position: absolute;
    left: 0;
    top: 2px;
    width: 291px;
    height: 291px;
    border: 1px solid #e3d7fe;
    border-radius: 50%;
  }

  .shape__line {
    position: absolute;
    display: block;
    line-height: 0;
  }

  /* The arc's export carries 0.4px of stroke bleed on every side. */
  .shape__line--arc {
    left: 49.66px;
    top: 32.61px;
  }

  .shape__line--inner {
    left: 50px;
    top: 51px;
  }

  .shape__dot {
    position: absolute;
    border-radius: var(--r-pill);
  }

  .shape__core {
    position: absolute;
    left: calc(50% - 0.5px);
    top: calc(50% - 0.5px);
    translate: -50% -50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    width: 174px;
    height: 174px;
    border-radius: 50%;
    background: linear-gradient(180deg, var(--c-accent), #4e05ef);
    box-shadow:
      inset 0 9.884px 15.814px rgba(255, 255, 255, 0.05),
      inset 0 1.977px 1.977px rgba(255, 255, 255, 0.25);
    text-align: center;
    line-height: 24px;
  }

  .shape__core-lead {
    font-size: var(--fs-sm);
    color: var(--c-bg-light);
  }

  .shape__core-title {
    font-weight: 500;
    font-size: var(--fs-lg);
    color: #fff;
  }

  /* --- steps ------------------------------------------------------------- */

  .shape__steps {
    position: relative;
    flex: 1 0 0;
    min-width: 0;
    height: 368px;
    list-style: none;
  }

  .shape__step {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .shape__step--left {
    left: 0;
  }

  .shape__step--right {
    right: 0;
  }

  .shape__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: var(--r-pill);
    background: var(--c-accent);
    color: #fff;
    line-height: 0;
  }

  .shape__step-text {
    flex: 1 0 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    line-height: 24px;
  }

  .shape__step-title {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: var(--fs-md);
    line-height: 24px;
    color: var(--c-ink);
  }

  .shape__step-body {
    font-size: var(--fs-body);
    color: var(--c-muted);
  }
</style>
