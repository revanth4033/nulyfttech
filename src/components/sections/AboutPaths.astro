---
import Icon from "../ui/Icon.astro";
import { starts, branches, trunk, pathDots, routes, nextStep, PATHS_STAGE } from "../../data/about";

/**
 * "The next step" — Figma 669:3634, 1440 x 704.
 *
 * Three starting points on the left whose lines converge on the nuLyft mark
 * at the right. Figma places every piece absolutely inside a 1240 x 504 box,
 * so it is reproduced as placed. The two curved branches are the same export,
 * the lower one flipped; each line fades in from nothing on its left half.
 *
 * Motion (`scripts/about-paths.ts`): each dot travels its line into the mark
 * and the mark glows as it lands. With JS off, or reduced motion, the dots
 * rest where Figma draws them.
 *
 * Narrower than the design:
 * - 1181-1439 the stage scales as one picture (`fit.ts`, >= 0.79, so the
 *   bodies stay above 12px). At 1440 the scale is switched off.
 * - At 1180 and below the same composition is rebuilt in flow (`.flow`):
 *   the three starting points stacked, their lines converging on the mark —
 *   beside them on a tablet, below them on a phone, where the lines run
 *   right into one trunk that drops into the mark. Text cannot be scaled to
 *   fit there (it would be ~10px), and its wrapping decides where each line
 *   starts, so the lines are drawn from the laid-out positions by the
 *   script, and redrawn on resize. The two layouts are both in the markup;
 *   one is always `display: none`.
 */
const px = (n: number) => `${n}px`;
---

<section class="paths" data-section="about-paths">
  <div class="container">
    <div
      class="fit paths__fit"
      data-fit={PATHS_STAGE.w}
      style={`--fit-w:${PATHS_STAGE.w};--fit-h:${PATHS_STAGE.h}`}
    >
    <div class="fit__inner paths__stage">
      {
        branches.map((b) => (
          <span
            class:list={["paths__line", { "paths__line--flip": b.flip }]}
            style={`left:${px(b.x)};top:${px(b.y)}`}
            aria-hidden="true"
          >
            <Icon name="brand/about/branch" width={631} height={204.2} />
          </span>
        ))
      }
      <span class="paths__line" style={`left:${px(trunk.x)};top:${px(trunk.y)}`} aria-hidden="true">
        <Icon name="brand/about/trunk" width={695.012} height={1.2} />
      </span>

      {/* The routes the dots travel, for measuring only — never painted. */}
      <svg class="paths__routes" width="0" height="0" fill="none" aria-hidden="true" focusable="false">
        {routes.map((r) => <path d={r.d} data-route />)}
      </svg>

      {
        pathDots.map((d) => (
          <span class="paths__dot" style={`left:${px(d.x)};top:${px(d.y)}`} aria-hidden="true" data-dot />
        ))
      }

      <ul class="paths__starts">
        {
          starts.map((s) => (
            <li class="paths__start" style={`left:${px(s.x)};top:${px(s.y)}`} data-animate>
              <span class="paths__chip">
                <Icon name="icons/about/check-circle" size={24} />
              </span>
              <span class="paths__text">
                <h3 class="paths__title">{s.title}</h3>
                <p class="paths__body">{s.body}</p>
              </span>
            </li>
          ))
        }
      </ul>

      <span
        class="paths__mark"
        style={`left:${px(nextStep.markX)};top:${px(nextStep.markY)}`}
        aria-hidden="true"
        data-mark
      >
        <span class="paths__pulse" data-pulse></span>
        <Icon name="brand/about/next-mark" size={40} />
      </span>

      <div class="paths__goal" style={`left:${px(nextStep.labelX)};top:${px(nextStep.labelY)}`} data-animate>
        <p class="paths__goal-label">{nextStep.label}</p>
        <span class="paths__underline" aria-hidden="true">
          <Icon name="brand/about/underline" width={134} height={1} />
        </span>
      </div>
    </div>
    </div>

    <div class="flow" data-flow>
      <ul class="flow__starts">
        {
          starts.map((s) => (
            <li class="flow__start" data-flow-start data-animate>
              <span class="paths__chip">
                <Icon name="icons/about/check-circle" size={24} uid="flow" />
              </span>
              <span class="paths__text">
                <h3 class="paths__title">{s.title}</h3>
                <p class="paths__body">{s.body}</p>
              </span>
            </li>
          ))
        }
      </ul>

      <div class="flow__goal" data-animate>
        <span class="paths__mark flow__mark" aria-hidden="true" data-flow-mark>
          <span class="paths__pulse" data-flow-pulse></span>
          <Icon name="brand/about/next-mark" size={40} uid="flow" />
        </span>
        <p class="paths__goal-label">{nextStep.label}</p>
      </div>

      <svg class="flow__lines" aria-hidden="true" focusable="false" fill="none" data-flow-lines>
        <defs>
          <linearGradient id="flow-line" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="1" y2="0" data-flow-grad>
            <stop stop-color="#834DFB" stop-opacity="0" />
            <stop offset="0.5" stop-color="#834DFB" />
          </linearGradient>
        </defs>
        {starts.map(() => <path stroke="url(#flow-line)" stroke-width="1.2" data-flow-route />)}
      </svg>

      {starts.map(() => <span class="paths__dot flow__dot" aria-hidden="true" data-flow-dot />)}
    </div>
  </div>
</section>

<style>
  .paths {
    background: var(--c-bg-light);
    padding-block: var(--section-y);
  }

  /* The stage is the fit wrapper's 1240 x 504 inner box; a position here
     would outrank `.fit__inner`'s and leave the wrapper too tall. At 1440
     the scale is exactly 1, and a scale(1) transform still re-rasterises
     the text, so it is switched off there. */
  @media (min-width: 1440px) {
    .paths__stage.fit__inner {
      transform: none;
    }
  }

  /* Flex, not block: the inlined <Icon> otherwise sits on a text baseline,
     which dropped the 1.2px trunk 4.8px inside a 6px box and smeared it grey
     across two pixel rows. */
  .paths__line {
    position: absolute;
    display: flex;
  }

  .paths__line--flip {
    scale: 1 -1;
  }

  .paths__dot {
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: var(--r-pill);
    background: var(--c-accent);
  }

  /* --- starting points --------------------------------------------------- */

  .paths__starts {
    list-style: none;
  }

  .paths__start {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 12px;
    width: 350px;
  }

  .paths__chip {
    flex: none;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: var(--r-pill);
    background: var(--c-accent-tint);
    color: var(--c-accent);
    line-height: 0;
  }

  .paths__text {
    flex: 1 0 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .paths__title {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: var(--fs-md);
    line-height: 24px;
    letter-spacing: var(--tr-project-title);
    color: var(--c-ink);
  }

  .paths__body {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--c-muted);
  }

  /* --- the next step ----------------------------------------------------- */

  /* A 40px disc in a 20px ring of tinted accent — Figma's outside stroke. */
  .paths__mark {
    position: absolute;
    display: flex;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    box-shadow: 0 0 0 20px rgba(131, 77, 251, 0.12);
    line-height: 0;
  }

  /* The glow the mark gives off as a dot lands: a brighter, slightly larger
     copy of its ring, hidden at rest. Sits over the ring, under the disc. */
  .paths__pulse {
    position: absolute;
    inset: -20px;
    border-radius: 50%;
    background: rgba(131, 77, 251, 0.2);
    box-shadow: 0 0 28px 6px rgba(131, 77, 251, 0.32);
    opacity: 0;
    pointer-events: none;
  }

  .paths__mark :global(.icon) {
    position: relative;
    z-index: 1;
  }

  .paths__routes {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
    visibility: hidden;
  }

  .paths__goal {
    position: absolute;
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 134px;
  }

  .paths__goal-label {
    font-weight: 500;
    font-size: 18px;
    line-height: 24px;
    letter-spacing: var(--tr-project-title);
    color: var(--c-ink);
    white-space: nowrap;
  }

  /* The rule is a 0-high node whose 1px art sits just above it. */
  .paths__underline {
    position: relative;
    display: block;
    height: 0;
    line-height: 0;
  }

  .paths__underline :global(svg) {
    position: absolute;
    top: -1px;
    left: 0;
  }

  /* --- the flow version (1180 and below) --------------------------------- */

  .flow {
    display: none;
  }

  @media (max-width: 1180px) {
    .paths__fit {
      display: none;
    }

    /* Tablet: the starting points in a column on the left, the mark on the
       right at their middle, the lines converging across the gap between —
       the desktop composition, laid out rather than placed. */
    .flow {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 380px) minmax(120px, 1fr) auto;
      align-items: center;
    }

    .flow__starts {
      grid-column: 1;
      display: flex;
      flex-direction: column;
      gap: 56px;
      list-style: none;
    }

    .flow__start {
      position: relative;
      z-index: 1;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .flow__goal {
      position: relative;
      z-index: 1;
      grid-column: 3;
      display: flex;
      align-items: center;
      gap: 20px;
      /* Room for the mark's 20px ring on the left. */
      padding-left: 20px;
    }

    .flow__mark {
      position: relative;
    }

    .flow__lines {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      overflow: visible;
      pointer-events: none;
    }

    /* Placed by the script; nothing to show until it has drawn the lines,
       and nothing at all without motion. */
    .flow__dot {
      left: 0;
      top: 0;
      opacity: 0;
    }
  }

  @media (max-width: 900px) {

    .flow {
      grid-template-columns: minmax(0, 320px) minmax(96px, 1fr) auto;
    }

    .flow__starts {
      gap: 40px;
    }

    .paths__text {
      gap: 8px;
    }
  }

  /* Phone: the starting points take the column, less a 92px lane on the
     right. Each line runs out into that lane, down one shared trunk, and into
     the mark at its foot, labelled on its left. */
  @media (max-width: 700px) {
    .flow {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }

    .flow__starts {
      padding-right: 92px;
      gap: 32px;
    }

    .flow__start {
      align-items: flex-start;
    }

    .flow__goal {
      grid-column: 1;
      justify-self: end;
      flex-direction: row-reverse;
      gap: 16px;
      padding: 0 20px 0 0;
    }
  }

  @media (max-width: 560px) {

    .paths__chip {
      width: 40px;
      height: 40px;
    }

    /* Size the icon's box, not just the drawing: shrinking only the svg
       left it in the top-left of its box, off centre in the chip. */
    .paths__chip :global(.icon) {
      width: 20px;
      height: 20px;
    }

    .paths__title {
      font-size: var(--fs-body);
      line-height: 22px;
    }

    .paths__body {
      font-size: var(--fs-sm);
      line-height: 20px;
    }

    .paths__text {
      gap: 4px;
    }

    .paths__goal-label {
      font-size: var(--fs-sm);
      line-height: 20px;
    }
  }
</style>
