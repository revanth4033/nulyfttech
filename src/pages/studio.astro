---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import CentredHero from "../components/sections/CentredHero.astro";
import StudioProjects from "../components/sections/StudioProjects.astro";
import CtaFooter from "../components/sections/CtaFooter.astro";
import { hero } from "../data/studio";
---

<BaseLayout
  title="Our Work — nuLyft"
  description="Turning business needs into solutions. Selected case studies in product design and engineering from nuLyft."
>
  <Nav slot="overlay" />

  <CentredHero {...hero} />
  <StudioProjects />
  <CtaFooter />
</BaseLayout>

<script>
  import "../scripts/reveal.ts";
  import "../scripts/anchors.ts";
  import "../scripts/cta-fan.ts";
</script>
