---
/**
 * An image filling its parent the way a Figma image fill does.
 *
 * Figma crops a fill with an image transform rather than a cover fit, and
 * codegen reports it as the image's own box in percentages of the frame.
 * Reproducing that box keeps every crop identical to the frame. The parent
 * must be positioned and clip.
 */
import { Image } from "astro:assets";
import type { Shot } from "../../data/capProductDesign";

interface Props {
  shot: Shot;
  /** Rendered width of the frame, for the srcset. */
  boxW: number;
  class?: string;
  eager?: boolean;
}

const { shot, boxW, class: className, eager = false } = Astro.props;
const { crop } = shot;
const w = Math.round(boxW * (crop === "cover" ? 1 : crop.w / 100));
const style =
  crop === "cover"
    ? "inset:0;width:100%;height:100%;object-fit:cover"
    : `width:${crop.w}%;height:${crop.h}%;left:${crop.left}%;top:${crop.top}%`;
---

<Image
  src={shot.src}
  alt={shot.alt}
  width={w}
  widths={[w, w * 2]}
  sizes={`${w}px`}
  class:list={["fill", className]}
  style={style}
  loading={eager ? "eager" : "lazy"}
/>

<style>
  .fill {
    position: absolute;
    max-width: none;
  }
</style>
