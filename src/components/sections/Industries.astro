---
import GridLines from "../ui/GridLines.astro";
import EyebrowBadge from "../ui/EyebrowBadge.astro";
import Icon from "../ui/Icon.astro";
import {
  pills,
  anchorOf,
  originOf,
  BOX,
  CX,
  CY,
  SPHERE,
  RING_A,
  M_RING_A,
  M_RING_B,
  M_SPHERE,
  M_PILL_H,
  RING_B,
  R_OUTER,
  PULSE_FROM,
  PILL_H,
} from "../../data/industries";

/**
 * Industries We Serve. Copy on the left, hub-and-constellation on the right.
 * Motion lives in `src/scripts/industries.ts`.
 */
const links = pills.map((p) => ({ from: originOf(p), to: anchorOf(p) }));
const pulse = R_OUTER * 2;
---

<section class="ind" data-section="industries">
  <GridLines />

  <div class="ind__inner">
    <div class="ind__copy">
      <EyebrowBadge variant="section" data-animate>Industries we serve</EyebrowBadge>
      <h2 class="ind__title" data-animate>Different industries. Same focus on solving the right problem</h2>
      <p class="ind__body" data-animate>
        We adapt our product expertise across industries, designing solutions around each
        domain&rsquo;s unique users, workflows, and business goals.
      </p>
    </div>

    <div class="ind__stage" data-ind>
      <span class="ind__halo" aria-hidden="true">
        <Icon name="brand/ind-rings-b" width={RING_B.size} height={RING_B.size} class="ind__ringart" />
      </span>
      <span class="ind__rings" data-rings aria-hidden="true">
        <Icon name="brand/ind-rings-a" width={RING_A.size} height={RING_A.size} class="ind__ringart" />
      </span>

      <span class="ind__pulse" data-pulse aria-hidden="true"></span>

      <svg class="ind__links" viewBox={`0 0 ${BOX} ${BOX}`} width={BOX} height={BOX} fill="none" aria-hidden="true">
        {
          links.map((l) => (
            <line class="ind__link" data-link x1={l.from.x} y1={l.from.y} x2={l.to.x} y2={l.to.y} />
          ))
        }
      </svg>

      <span class="ind__hub" aria-hidden="true">
        <Icon name="brand/nulyft-mark" width={96} height={47} />
      </span>

      {
        pills.map((p) => (
          <div
            class="ind__pill"
            data-pill
            style={`--px:${p.x}px;--py:${p.y}px;--mpx:${p.mx}px;--mpy:${p.my}px`}
          >
            <span class="ind__tile"><Icon name={p.icon} size={18} /></span>
            <span class="ind__label">{p.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style
  define:vars={{
    box: `${BOX}px`,
    cx: `${CX}px`,
    cy: `${CY}px`,
    sphere: `${SPHERE}px`,
    ringAOff: `${RING_A.offset}px`,
    ringBOff: `${RING_B.offset}px`,
    pulse: `${pulse}px`,
    pulseOff: `${CX - R_OUTER}px`,
    pulseFrom: PULSE_FROM,
    pillH: `${PILL_H}px`,
    mRingA: `${M_RING_A.size}px`,
    mRingAOff: `${M_RING_A.offset}px`,
    mRingB: `${M_RING_B.size}px`,
    mRingBOffX: `${M_RING_B.offsetX}px`,
    mRingBOffY: `${M_RING_B.offsetY}px`,
    mSphere: `${M_SPHERE}px`,
    mPillH: `${M_PILL_H}px`,
  }}
>
  .ind {
    position: relative;
    background: var(--c-bg-light);
    overflow: hidden;
  }

  .ind__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--frame-w);
    height: calc(var(--box) + 200px);
    margin-inline: auto;
    padding: var(--section-y) var(--gutter);
  }

  /* --- copy -------------------------------------------------------------- */

  /* Figma centres the block against the constellation, not the section. */
  .ind__copy {
    position: absolute;
    left: var(--gutter);
    top: 50%;
    translate: 0 -50%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .ind__title {
    width: 469px;
    max-width: 100%;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 32px;
    line-height: normal;
    letter-spacing: var(--tr-h2);
    color: var(--c-heading);
  }

  .ind__body {
    width: 624px;
    max-width: 100%;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--c-muted);
  }

  /* --- constellation ----------------------------------------------------- */

  /* The pills overflow this box by up to 145px either side on purpose; the
     section clips them, not the stage. */
  .ind__stage {
    position: absolute;
    left: calc(var(--gutter) + 742px);
    top: 100px;
    width: var(--box);
    height: var(--box);
  }

  .ind__halo,
  .ind__rings,
  .ind__pulse,
  .ind__links,
  .ind__hub {
    position: absolute;
    display: block;
    /* <Icon> renders inline-flex, which would otherwise leave a descender
       gap under these wrappers and make their boxes taller than their art. */
    line-height: 0;
  }

  /* Same four radii as the dashed set, but 11px strokes under a 30px blur. */
  .ind__halo {
    left: var(--ringBOff);
    top: var(--ringBOff);
  }

  .ind__rings {
    left: var(--ringAOff);
    top: var(--ringAOff);
    transform-origin: 50% 50%;
  }

  /* The wavefront. Starts at the sphere's edge and runs out past the last
     ring; the border thickens as it scales, which reads as it dissipating. */
  .ind__pulse {
    left: var(--pulseOff);
    top: var(--pulseOff);
    width: var(--pulse);
    height: var(--pulse);
    border: 2px solid rgba(176, 140, 250, 0.5);
    border-radius: 50%;
    opacity: 0;
    scale: var(--pulseFrom);
    filter: blur(2px);
  }

  .ind__links {
    left: 0;
    top: 0;
    overflow: visible;
    pointer-events: none;
  }

  .ind__link {
    stroke: var(--c-accent);
    stroke-width: 1.5;
    stroke-linecap: round;
    opacity: 0;
  }

  .ind__hub {
    left: calc(var(--cx) - var(--sphere) / 2);
    top: calc(var(--cy) - var(--sphere) / 2);
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--sphere);
    height: var(--sphere);
    border-radius: 50%;
    color: #fff;
    background: linear-gradient(to bottom, #834dfb, #4e05ef);
    box-shadow:
      0 7.9px 15.2px rgba(0, 0, 0, 0.05),
      0 19.8px 47.4px rgba(0, 0, 0, 0.05),
      0 47.4px 80.7px rgba(0, 0, 0, 0.15),
      0 49.4px 37px rgba(0, 0, 0, 0.05),
      inset 0 9.9px 15.8px rgba(255, 255, 255, 0.05),
      inset 0 2px 2px rgba(255, 255, 255, 0.25);
  }

  /* --- pills ------------------------------------------------------------- */

  .ind__pill {
    position: absolute;
    left: var(--px);
    top: var(--py);
    display: flex;
    align-items: center;
    gap: 6px;
    height: var(--pillH);
    padding: 6px 16px 6px 6px;
    background: #fff;
    border-radius: 12px;
    box-shadow: inset 0 1px 4px rgba(0, 0, 0, 0.25);
    white-space: nowrap;
    will-change: transform, opacity;
  }

  .ind__tile {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 9px;
    color: #fff;
    background: var(--c-accent);
    box-shadow:
      0 4px 4px rgba(0, 0, 0, 0.12),
      0 4px 8px rgba(0, 0, 0, 0.05),
      0 9px 15px rgba(0, 0, 0, 0.08);
  }

  .ind__label {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: var(--fs-body);
    line-height: 1.5;
    color: var(--c-ink);
  }

  /* ------------------------------------------------------------------------
     Mobile — Figma 493:2737

     The copy moves above the constellation and centres; the square itself
     stays 396.25, so only the rings, the hub and the pills resize. Every one
     of those is already a custom property, so this is mostly a token swap —
     the pill coordinates had to leave their inline `left`/`top` first, since
     an inline declaration beats a media query.
     ------------------------------------------------------------------------ */
  @media (max-width: 900px) {
    .ind__inner {
      display: flex;
      flex-direction: column;
      align-items: center;
      /* Figma insets the 396.25 square 22px inside a 418-tall wrapper, so the
         gap from the header to the square's own top edge is 61, not 39. */
      gap: 61px;
      height: auto;
    }

    .ind__copy {
      position: static;
      align-items: center;
      gap: 16px;
      width: 100%;
      translate: none;
      text-align: center;
    }

    .ind__title {
      width: 100%;
      font-size: 20px;
      letter-spacing: -1px;
    }

    .ind__body {
      width: 100%;
      font-size: 12px;
      line-height: 18px;
    }

    .ind__stage {
      position: relative;
      left: auto;
      top: auto;
    }

    /* `define:vars` sets the desktop tokens on the elements themselves, so a
       redefinition further up the tree cannot reach them — these write the
       concrete properties rather than re-pointing the variables. */
    .ind__rings {
      left: var(--mRingAOff);
      top: var(--mRingAOff);
    }

    /* The halo is the one piece Figma does not centre — it sits 21px low. */
    .ind__halo {
      left: var(--mRingBOffX);
      top: var(--mRingBOffY);
    }

    .ind__hub {
      left: calc(var(--cx) - var(--mSphere) / 2);
      top: calc(var(--cy) - var(--mSphere) / 2);
      width: var(--mSphere);
      height: var(--mSphere);
    }

    .ind__rings :global(.ind__ringart) {
      width: var(--mRingA);
      height: var(--mRingA);
    }

    .ind__halo :global(.ind__ringart) {
      width: var(--mRingB);
      height: var(--mRingB);
    }

    .ind__hub :global(.icon) {
      width: 54px;
      height: 26px;
    }

    .ind__pill {
      left: var(--mpx);
      top: var(--mpy);
      gap: 6px;
      height: var(--mPillH);
      padding: 6px 16px 6px 6px;
      border-radius: 10px;
    }

    .ind__tile {
      width: 22px;
      height: 22px;
    }

    .ind__tile :global(.icon) {
      width: 12px;
      height: 12px;
    }

    .ind__label {
      font-size: 12px;
    }
  }

  @media (max-width: 1180px) {
    .ind__body {
      width: 520px;
    }
  }
</style>
