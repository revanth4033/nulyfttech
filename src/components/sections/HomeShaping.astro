---
import Icon from "../ui/Icon.astro";
import PillButton from "../ui/PillButton.astro";
import { shaping, orbitDots } from "../../data/home";

/**
 * "Shaping what businesses can do with technology" — Figma 664:3173 ("Work"),
 * 1440 x 568.
 *
 * Copy on the left, the "Possibility into Progress" disc in its orbit in the
 * middle, and three steps on the right set in a zig-zag: the middle one is
 * pushed to the column's right edge. The orbit is a 291 x 295 composition —
 * two rings, an open arc and nine dots — placed at Figma's coordinates.
 *
 * Narrower than the design: 1241-1439 the copy column gives way and the
 * steps hold at least their own 377. At 1240 and below the copy moves on
 * top and the orbit and steps share the row under it; on phones the steps
 * become a short timeline under the orbit, joined through their icons.
 * Step positions reach the CSS as custom properties — inline `top`/`width`
 * would beat every media query.
 *
 * Motion (user-approved), three layers:
 * - Connectors: thin curves from the outer ring to each step's icon (on a
 *   phone, one curve from the ring's foot to the timeline). Not in Figma —
 *   added so the orbit and the steps read as one diagram. Drawn by the
 *   script from the laid-out positions and redrawn on resize, because every
 *   breakpoint moves the steps; drawn outside `registerSection`, so they are
 *   there under reduced motion too.
 * - Entrance, once: an arc sweeps the ring's right half from 12 to 6
 *   o'clock like a progress meter; as it passes each connector's root the
 *   connector draws out and that step lights up; then the disc pulses and
 *   the sweep fades. On a phone the steps are never dimmed — each one's icon
 *   lights as it scrolls in.
 * - Ambient: the ring dots drift round the orbit and the open arc turns, at
 *   different slow speeds, and a halo breathes behind the disc. CSS only,
 *   paused off screen, off under reduced motion.
 */
const px = (n: number) => `${n}px`;

/** The orbit's centre in its own 291 x 295 box (the ring is 291 at top 2). */
const C = { x: 145.5, y: 147.5 };

/** A stable 0-1 value per dot and channel — the same drift every build. */
const rand = (i: number, k: number) => {
  const v = Math.sin(i * 12.9898 + k * 78.233) * 43758.5453;
  return v - Math.floor(v);
};

/**
 * Each dot turns about the orbit's centre, so it stays on its own ring:
 * transform-origin is the centre in the dot's own box. 60-110s a lap,
 * alternate dots the other way.
 */
const drift = orbitDots.map((d, i) => {
  const ox = C.x - d.x;
  const oy = C.y - d.y;
  const dur = 60 + rand(i, 1) * 50;
  const dir = i % 2 ? "reverse" : "normal";
  return `--ox:${ox}px;--oy:${oy}px;--dur:${dur.toFixed(1)}s;--dir:${dir};--del:${(-rand(i, 2) * dur).toFixed(1)}s`;
});
---

<section class="shape" data-section="home-shaping">
  <div class="shape__inner container" data-shape-inner>
    <svg class="shape__links" aria-hidden="true" focusable="false" fill="none" data-shape-links>
      {shaping.steps.map(() => <path data-shape-link />)}
    </svg>

    <div class="shape__copy">
      <div class="shape__text">
        <h2 class="shape__title" data-animate>{shaping.title}</h2>
        <p class="shape__body" data-animate>{shaping.body}</p>
      </div>
      <div class="shape__cta" data-animate>
        <PillButton href={shaping.cta.href} variant="outline" arrow={20} arrowIcon="icons/arrow-circle-20-outline">
          {shaping.cta.label}
        </PillButton>
      </div>
    </div>

    <div class="shape__orbit" data-animate data-shape-orbit>
      <span class="shape__ring" aria-hidden="true"></span>
      <span class="shape__line shape__line--arc" aria-hidden="true">
        <Icon name="brand/home/orbit-segment" width={210.73} height={229.8} />
      </span>
      <span class="shape__line shape__line--inner" aria-hidden="true">
        <Icon name="brand/home/inner-orbit" width={191} height={192} />
      </span>
      {
        orbitDots.map((d, i) => (
          <span
            class="shape__dot"
            style={`left:${px(d.x)};top:${px(d.y)};width:${px(d.s)};height:${px(d.s)};background:${d.c};${drift[i]}`}
            aria-hidden="true"
          />
        ))
      }
      {/* The entrance's progress sweep, over the outer ring's right half. */}
      <svg class="shape__sweep" width="291" height="295" viewBox="0 0 291 295" fill="none" aria-hidden="true" focusable="false">
        <circle cx={C.x} cy={C.y} r="145" stroke-width="2" data-shape-sweep />
      </svg>
      <span class="shape__halo" aria-hidden="true" data-shape-halo></span>
      <p class="shape__core" data-shape-core>
        <span class="shape__core-lead">{shaping.core.lead}</span>
        <span class="shape__core-title">{shaping.core.title}</span>
      </p>
    </div>

    <ol class="shape__steps">
      {
        shaping.steps.map((s) => (
          <li
            class:list={["shape__step", `shape__step--${s.align}`]}
            style={`--top:${px(s.y)};--w:${px(s.w)}`}
            data-shape-step
          >
            <span class="shape__icon">
              <Icon name={s.icon} size={28} />
            </span>
            <span class="shape__step-text">
              <h3 class="shape__step-title">{s.title}</h3>
              <p class="shape__step-body">{s.body}</p>
            </span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .shape {
    background: var(--c-bg-light);
    padding-block: var(--section-y);
  }

  .shape__inner {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  /* --- copy -------------------------------------------------------------- */

  .shape__copy {
    flex: 0 0 439px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 32px;
  }

  .shape__text {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .shape__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-h2);
    line-height: normal;
    letter-spacing: var(--tr-h2);
    color: var(--c-ink);
  }

  .shape__body {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--c-muted);
  }

  .shape__cta {
    display: flex;
    align-items: center;
    height: 50.232px;
  }

  /* --- orbit ------------------------------------------------------------- */

  .shape__orbit {
    position: relative;
    flex: none;
    width: 291px;
    height: 295px;
  }

  .shape__ring {
    position: absolute;
    left: 0;
    top: 2px;
    width: 291px;
    height: 291px;
    border: 1px solid #e3d7fe;
    border-radius: 50%;
  }

  .shape__line {
    position: absolute;
    display: block;
    line-height: 0;
  }

  /* The arc's export carries 0.4px of stroke bleed on every side. */
  .shape__line--arc {
    left: 49.66px;
    top: 32.61px;
  }

  .shape__line--inner {
    left: 50px;
    top: 51px;
  }

  .shape__dot {
    position: absolute;
    border-radius: var(--r-pill);
  }

  .shape__core {
    position: absolute;
    left: calc(50% - 0.5px);
    top: calc(50% - 0.5px);
    translate: -50% -50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    width: 174px;
    height: 174px;
    border-radius: 50%;
    background: linear-gradient(180deg, var(--c-accent), #4e05ef);
    box-shadow:
      inset 0 9.884px 15.814px rgba(255, 255, 255, 0.05),
      inset 0 1.977px 1.977px rgba(255, 255, 255, 0.25);
    text-align: center;
    line-height: 24px;
  }

  .shape__core-lead {
    font-size: var(--fs-sm);
    color: var(--c-bg-light);
  }

  .shape__core-title {
    font-weight: 500;
    font-size: var(--fs-lg);
    color: #fff;
  }

  /* --- motion layers ----------------------------------------------------- */

  .shape__inner {
    position: relative;
  }

  /* The connectors: one overlay across the whole row, drawn by the script in
     the row's own coordinates. Under everything else. */
  .shape__links {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .shape__links path {
    stroke: #c7b0fd;
    stroke-width: 1.2;
  }

  /* Hidden until the entrance runs it; at rest the ring is Figma's. */
  .shape__sweep {
    position: absolute;
    inset: 0;
    overflow: visible;
    pointer-events: none;
  }

  .shape__sweep circle {
    stroke: var(--c-accent);
    stroke-linecap: round;
    opacity: 0;
    /* Start the stroke at 12 o'clock, running clockwise. */
    transform: rotate(-90deg);
    transform-origin: 145.5px 147.5px;
  }

  /* A soft light behind the disc. It breathes; the entrance flashes it. */
  .shape__halo {
    position: absolute;
    left: calc(50% - 0.5px);
    top: calc(50% - 0.5px);
    width: 230px;
    height: 230px;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(131, 77, 251, 0.34), rgba(131, 77, 251, 0.12) 60%, rgba(131, 77, 251, 0));
    opacity: 0.55;
    pointer-events: none;
    animation: shape-breathe 5s ease-in-out infinite alternate;
  }

  @keyframes shape-breathe {
    from { opacity: 0.4; transform: scale(0.96); }
    to { opacity: 0.85; transform: scale(1.04); }
  }

  /* Each dot turns about the orbit's centre (its --ox/--oy), so it keeps to
     its ring; the open arc turns too, slower still. */
  .shape__dot {
    transform-origin: var(--ox) var(--oy);
    animation: shape-turn var(--dur) linear var(--del) infinite;
    animation-direction: var(--dir);
  }

  .shape__line--arc {
    transform-origin: 95.84px 114.89px;
    animation: shape-turn 120s linear infinite;
  }

  @keyframes shape-turn {
    to { transform: rotate(360deg); }
  }

  .shape.is-idle .shape__dot,
  .shape.is-idle .shape__line--arc,
  .shape.is-idle .shape__halo {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .shape__dot,
    .shape__line--arc,
    .shape__halo {
      animation: none;
    }
  }

  /* --- steps ------------------------------------------------------------- */

  .shape__steps {
    position: relative;
    flex: 1 0 0;
    min-width: 0;
    height: 368px;
    list-style: none;
  }

  .shape__step {
    position: absolute;
    top: var(--top);
    width: var(--w);
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .shape__step--left {
    left: 0;
  }

  .shape__step--right {
    right: 0;
  }

  .shape__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: var(--r-pill);
    background: var(--c-accent);
    color: #fff;
    line-height: 0;
  }

  .shape__step-text {
    flex: 1 0 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    line-height: 24px;
  }

  .shape__step-title {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: var(--fs-md);
    line-height: 24px;
    color: var(--c-ink);
  }

  .shape__step-body {
    font-size: var(--fs-body);
    color: var(--c-muted);
  }

  /* --- narrower than the design ------------------------------------------ */

  /* The steps' column is 446 at 1440 (the zig-zag's full width) and may
     close to 377, the widest single step; the copy takes the rest. */
  @media (max-width: 1439px) {
    .shape__copy {
      flex: 0 1 439px;
      min-width: 0;
    }

    .shape__steps {
      flex: 1 1 446px;
      min-width: 377px;
    }
  }

  /* Copy on top, then the orbit beside the zig-zag. */
  @media (max-width: 1240px) {
    .shape__inner {
      flex-wrap: wrap;
      justify-content: center;
      gap: 48px 40px;
    }

    .shape__copy {
      flex: 0 0 100%;
    }

    .shape__text {
      max-width: 640px;
    }

    /* Basis at the 377 minimum: a wrapping row breaks on the basis before
       anything shrinks, so a 446 basis dropped the steps under the orbit at
       960 with room to spare. */
    .shape__steps {
      flex: 1 1 377px;
      max-width: 446px;
    }
  }

  @media (max-width: 900px) {

    .shape__inner {
      gap: 40px 32px;
    }

    .shape__title {
      font-size: 30px;
      letter-spacing: -1px;
    }
  }

  /* Under 768 the orbit (291) and the steps (377 at least) no longer fit
     side by side. Orbit centred, then the three steps as a timeline — the
     zig-zag has no room to zig, so the line through the icons carries the sense of
     sequence instead. */
  @media (max-width: 767px) {
    .shape__inner {
      flex-direction: column;
      align-items: stretch;
      gap: 40px;
    }

    .shape__orbit {
      align-self: center;
    }

    .shape__steps {
      flex: none;
      min-width: 0;
      height: auto;
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    .shape__steps::before {
      content: "";
      position: absolute;
      top: 28px;
      bottom: 28px;
      left: 27.4px;
      width: 1.2px;
      background: var(--c-accent-tint);
    }

    .shape__step {
      position: relative;
      top: auto;
      left: auto;
      right: auto;
      width: auto;
      align-items: flex-start;
      gap: 16px;
    }

    .shape__step-text {
      gap: 4px;
      padding-top: 4px;
    }
  }

  @media (max-width: 560px) {

    .shape__title {
      font-size: 24px;
      letter-spacing: -0.6px;
    }

    .shape__body {
      font-size: var(--fs-sm);
      line-height: 22px;
    }

    .shape__icon {
      width: 48px;
      height: 48px;
    }

    /* Size the icon's box, not just the drawing: shrinking only the svg
       left it in the top-left of its box, off centre in the chip. */
    .shape__icon :global(.icon) {
      width: 24px;
      height: 24px;
    }

    .shape__steps::before {
      top: 24px;
      bottom: 24px;
      left: 23.4px;
    }

    .shape__step-title {
      font-size: var(--fs-body);
      line-height: 22px;
    }

    .shape__step-body {
      font-size: var(--fs-sm);
      line-height: 22px;
    }

    .shape__step-text {
      padding-top: 2px;
    }
  }

  /* The orbit is a fixed 291 picture holding a little text; under 330 it
     would touch the gutters, so it steps down as one piece. */
  @media (max-width: 340px) {
    /* `scale`, not `zoom`, so layout offsets stay true for the connector
       script, which reads the factor from --orbit-s. Scaling about the
       centre leaves 291 x 295 of layout; the margins hand back the 8%. */
    .shape__orbit {
      --orbit-s: 0.92;
      scale: var(--orbit-s);
      margin: -11.8px -11.6px;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, registerSection } from "../../scripts/gsap";

  const root = document.querySelector<HTMLElement>(".shape");
  const inner = root?.querySelector<HTMLElement>("[data-shape-inner]");
  const orbit = root?.querySelector<HTMLElement>("[data-shape-orbit]");
  const list = root?.querySelector<HTMLElement>(".shape__steps");
  const steps = root ? Array.from(root.querySelectorAll<HTMLElement>("[data-shape-step]")) : [];
  const links = root ? Array.from(root.querySelectorAll<SVGPathElement>("[data-shape-link]")) : [];

  /** The orbit's centre in its own box, and the ring's radius. */
  const CX = 145.5;
  const CY = 147.5;
  const R = 145;
  const PHONE = "(max-width: 767px)";

  /** Per connector: where the sweep reaches its root (0 = 12 o'clock, 180 =
      6 o'clock, clockwise) and its length. Empty connectors are skipped. */
  const meta = links.map(() => ({ angle: 0, length: 0 }));

  /**
   * Draw the connectors from the laid-out positions, in the row's own
   * coordinates. Offsets, not rects: the orbit carries a reveal transform.
   *
   * Beside the steps: each leaves the ring on the line towards its step's
   * icon, so the three fan out from one side of the ring, and eases in level
   * to the icon. Phone: the steps run down under the orbit, so one curve
   * drops from the ring's foot to the first icon; the timeline rail carries
   * on from there.
   */
  function drawLinks() {
    if (!inner || !orbit || !list || !inner.offsetWidth) return;
    const s = parseFloat(getComputedStyle(orbit).getPropertyValue("--orbit-s")) || 1;
    const cx = orbit.offsetLeft + CX;
    const cy = orbit.offsetTop + CY;
    const r = R * s;
    const phone = window.matchMedia(PHONE).matches;

    steps.forEach((step, i) => {
      const icon = step.querySelector<HTMLElement>(".shape__icon");
      const path = links[i];
      if (!icon || !path) return;
      const half = icon.offsetWidth / 2;
      const ix = list.offsetLeft + step.offsetLeft + icon.offsetLeft + half;
      const iy = list.offsetTop + step.offsetTop + icon.offsetTop + icon.offsetHeight / 2;

      let d = "";
      if (phone) {
        if (i === 0) {
          const ty = iy - half - 6;
          const k = Math.max(16, (ty - (cy + r)) / 2);
          d = `M${cx} ${cy + r}C${cx} ${cy + r + k} ${ix} ${ty - k} ${ix} ${ty}`;
          meta[i].angle = 180;
        }
      } else {
        const tx = ix - half - 8;
        const th = Math.atan2(iy - cy, tx - cx);
        const sx = cx + r * Math.cos(th);
        const sy = cy + r * Math.sin(th);
        const k = Math.hypot(tx - sx, iy - sy) * 0.45;
        d = Math.abs(iy - sy) < 0.5
          ? `M${sx} ${sy}H${tx}`
          : `M${sx} ${sy}C${sx + k * Math.cos(th)} ${sy + k * Math.sin(th)} ${tx - k} ${iy} ${tx} ${iy}`;
        meta[i].angle = (th * 180) / Math.PI + 90;
      }
      path.setAttribute("d", d);
      try {
        meta[i].length = d ? path.getTotalLength() : 0;
      } catch {
        meta[i].length = 0;
      }
    });
  }

  if (root && inner) {
    const redraw = () => requestAnimationFrame(drawLinks);
    new ResizeObserver(redraw).observe(inner);
    document.fonts?.ready.then(redraw);
    window.matchMedia(PHONE).addEventListener("change", redraw);

    // The ambient drift and the halo stop while the section is off screen.
    root.classList.add("is-idle");
    new IntersectionObserver(([e]) => root.classList.toggle("is-idle", !e.isIntersecting)).observe(root);
  }

  /** power1.inOut's inverse: at what share of the sweep it reaches `y`. */
  const atSweep = (y: number) => (y < 0.5 ? Math.sqrt(y / 2) : 1 - Math.sqrt((1 - y) / 2));

  const SWEEP = 1.5;
  const CIRC = 2 * Math.PI * R;

  registerSection(".shape", () => {
    if (!inner || !orbit) return;
    const sweep = orbit.querySelector<SVGCircleElement>("[data-shape-sweep]");
    const core = orbit.querySelector<HTMLElement>("[data-shape-core]");
    const icons = steps.map((s) => s.querySelector<HTMLElement>(".shape__icon")!);
    if (!sweep || !core) return;

    /** The sweep, and each connector drawing out as the sweep passes its
        root. Built at play time, from the lines as they are then laid out. */
    const entrance = (lightSteps: boolean) => {
      drawLinks();
      const tl = gsap.timeline();
      tl.set(sweep, { strokeDasharray: `${CIRC} ${CIRC}`, strokeDashoffset: CIRC, opacity: 1 }, 0)
        .to(sweep, { strokeDashoffset: CIRC / 2, duration: SWEEP, ease: "power1.inOut" }, 0)
        .to(sweep, { opacity: 0, duration: 0.6, ease: "power2.in" }, SWEEP + 0.25)
        .to(core, { scale: 1.06, duration: 0.25, ease: "power2.out" }, SWEEP)
        .to(core, { scale: 1, duration: 0.5, ease: "power2.inOut" }, SWEEP + 0.25);

      links.forEach((path, i) => {
        const { angle, length } = meta[i];
        if (!(length > 0)) return;
        const at = atSweep(Math.min(1, Math.max(0, angle / 180))) * SWEEP;
        tl.set(path, { strokeDasharray: `${length} ${length}`, strokeDashoffset: length, opacity: 1 }, 0)
          .to(path, { strokeDashoffset: 0, duration: 0.5, ease: "power2.out" }, at);
        if (lightSteps) {
          tl.to(steps[i], { opacity: 1, duration: 0.45, ease: "power2.out" }, at + 0.25);
          tl.fromTo(icons[i], { scale: 0.85 }, { scale: 1, duration: 0.5, ease: "back.out(2)" }, at + 0.25);
        }
      });

      // Back to the stylesheet once it has played — only what the entrance
      // set: "all" would also wipe each step's inline --top/--w, which is
      // what places the zig-zag.
      tl.set([sweep, ...links], { clearProps: "strokeDasharray,strokeDashoffset,opacity" })
        .set(core, { clearProps: "transform" })
        .set(steps, { clearProps: "opacity" })
        .set(icons, { clearProps: "transform" });
      return tl;
    };

    const mm = gsap.matchMedia();

    // Beside the steps: the steps wait dimmed and light in turn.
    mm.add("(min-width: 768px)", () => {
      gsap.set(steps, { opacity: 0.3 });
      gsap.set(links, { opacity: 0 });
      ScrollTrigger.create({ trigger: inner, start: "top 70%", once: true, onEnter: () => entrance(true) });
      return () => gsap.set([...steps, ...links], { clearProps: "opacity" });
    });

    // Phone: the steps are read as they scroll in, so they are never dimmed;
    // the sweep runs when the orbit arrives, and each step's icon lights as
    // the step comes into view.
    mm.add(PHONE, () => {
      gsap.set(links, { opacity: 0 });
      ScrollTrigger.create({ trigger: orbit, start: "top 75%", once: true, onEnter: () => entrance(false) });
      icons.forEach((icon) => {
        gsap.set(icon, { scale: 0.7, opacity: 0.4 });
        ScrollTrigger.create({
          trigger: icon,
          start: "top 85%",
          once: true,
          onEnter: () =>
            gsap.to(icon, {
              scale: 1,
              opacity: 1,
              duration: 0.55,
              ease: "back.out(2)",
              onComplete: () => gsap.set(icon, { clearProps: "transform,opacity" }),
            }),
        });
      });
      return () => gsap.set([...links, ...icons], { clearProps: "opacity,transform" });
    });
  });
</script>
