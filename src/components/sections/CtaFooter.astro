---
import { Image } from "astro:assets";
import Icon from "../ui/Icon.astro";
import screen1 from "../../assets/images/cta/screen-1.png";
import screen2 from "../../assets/images/cta/screen-2.png";
import screen3 from "../../assets/images/cta/screen-3.png";
import starfield from "../../assets/images/cta/starfield.png";
import facebook from "../../assets/icons/social/facebook.png";
import { screens, FAN_W, FAN_H, CARD_W, CARD_H } from "../../data/cta";

/**
 * CTA over the footer. Figma overlaps them: the CTA card runs y 0–416 while
 * the footer starts at 258, so the footer carries 240px of top padding to
 * clear it and the CTA is positioned over the seam.
 *
 * Footer is deliberately static. Motion for the card fan lives in
 * `src/scripts/cta-fan.ts`.
 */
const rasters = { "screen-1": screen1, "screen-2": screen2, "screen-3": screen3 };

/**
 * Pages may carry their own CTA copy (Product Engineering, AI & Automation),
 * so the block is prop-driven. The default title breaks after "building?",
 * where every frame wraps it; left to `text-wrap: balance` it split as
 * "...worth / building? Let's talk about it".
 */
interface Props {
  title?: string;
  body?: string;
  /** Copy column width. Figma draws 504; AI & Automation widens it to 642
      from the same left edge so its longer body sets in two lines. */
  copyWidth?: number;
  /**
   * `false` drops the CTA card and its overlap — Contact Us (672:3922) ends
   * on the footer alone, its content 141 down rather than 241.
   */
  cta?: boolean;
  /** The card's button label; Product Engineering reads "Discuss Your Project". */
  button?: string;
}

const {
  cta = true,
  button = "Start a Conversation",
  copyWidth = 504,
  title = "Have a product worth building?\nLet\u2019s talk about it",
  body = "Tell us what you\u2019re trying to solve, where you\u2019re stuck, or what you\u2019re planning next. We\u2019ll figure out the right way forward together.",
} = Astro.props;

/**
 * Footer columns — Figma 664:3250, from the redesigned home page. "UX
 * Capabilities" is the design's label for the Product Design page.
 */
const capabilities = [
  { label: "UX Capabilities", href: "/product-design" },
  { label: "Product Engineering", href: "/product-engineering" },
  { label: "AI & Automation", href: "/ai-automation" },
];
const company = [
  { label: "Work", href: "/studio" },
  { label: "About Us", href: "/about" },
  { label: "Careers", href: "/careers" },
];
const contact = [
  { label: "contact@nulyfttech.com", href: "mailto:contact@nulyfttech.com" },
  { label: "+91-7032648989", href: "tel:+917032648989" },
];
---

<div class:list={["outro", { "outro--plain": !cta }]}>
  {cta && (
  <section class="cta" data-section="cta">
    <span class="cta__stars" aria-hidden="true">
      <Image src={starfield} alt="" width={2000} widths={[1256, 2000]} sizes="1256px" quality={50} />
    </span>
    <span class="cta__tint" aria-hidden="true"></span>
    <span class="cta__arcs" aria-hidden="true"><Icon name="brand/cta-arcs" width={965} height={965} /></span>

    <div class="cta__copy" style={`--cta-copy-w:${copyWidth}px`}>
      <h2 class="cta__title" data-animate>{title}</h2>
      <p class="cta__body" data-animate>{body}</p>
      {/* The reveal goes on a wrapper: GSAP leaves `scale: none` inline on
          whatever it animates, which would cancel the button's press. */}
      <div class="cta__action" data-animate>
        <a class="cta__btn" href="/contact">
          <span class="cta__btn-label">{button}</span>
          <span class="cta__btn-arrow"><Icon name="icons/arrow-cta" width={33.2} height={33.2} /></span>
        </a>
      </div>
    </div>

    <div class="cta__fan" data-fan>
      {
        screens.map((s, i) => (
          <span class="cta__card" data-card data-slot={i}>
            <Image
              class="cta__shot"
              src={rasters[s.src as keyof typeof rasters]}
              alt={s.alt}
              width={1160}
              widths={[580, 1160]}
              sizes="580px"
              quality={62}
              style={`width:${s.crop.w}%;height:${s.crop.h}%;left:${s.crop.x}%;top:${s.crop.y}%`}
            />
          </span>
        ))
      }
    </div>
  </section>
  )}

  <footer class="foot">
    <div class="foot__top">
      <div class="foot__brand">
        <span class="foot__logo">
          <Icon name="brand/nulyft-wordmark" width={97.083} height={48.539} />
          <span class="foot__logo-sub"><em>technologies</em><em>Pvt Ltd</em></span>
        </span>
        <p class="foot__tagline">Products designed for people. Built for business.</p>
        <div class="foot__social">
          <span class="foot__social-label">Follow us on</span>
          <ul class="foot__social-list">
            <li>
              <a class="foot__social-btn" href="#" aria-label="Facebook">
                <Image src={facebook} alt="" width={14.222} height={14.222} densities={[1, 2]} />
              </a>
            </li>
            <li><a class="foot__social-btn" href="#" aria-label="YouTube"><Icon name="icons/social/youtube" size={17.067} /></a></li>
            <li><a class="foot__social-btn" href="#" aria-label="Instagram"><Icon name="icons/social/instagram" size={14.222} /></a></li>
          </ul>
        </div>
      </div>

      <nav class="foot__nav" aria-label="Footer">
        <div class="foot__col">
          <h3 class="foot__col-title">Capabilities</h3>
          <ul>{capabilities.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </div>
        <div class="foot__col foot__col--narrow">
          <h3 class="foot__col-title">Company</h3>
          <ul>{company.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </div>
        <div class="foot__col foot__col--contact">
          <h3 class="foot__col-title">Contact</h3>
          <ul>{contact.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </div>
      </nav>
    </div>

    <div class="foot__bar">
      <p>&copy; 2026 NuLyft. All rights reserved.</p>
      <ul class="foot__legal">
        <li><a href="#">Terms</a></li>
        <li><a href="#">Privacy</a></li>
        <li><a href="#">Support</a></li>
      </ul>
    </div>
  </footer>
</div>

<style define:vars={{ fanW: `${FAN_W}px`, fanH: `${FAN_H}px`, cardW: `${CARD_W}px`, cardH: `${CARD_H}px` }}>
  /* flow-root, not padding: the footer's top margin is what sets the
     overlap, and without a BFC here it collapses out of the wrapper and
     drags the whole block down instead. Padding would work too, but an
     absolutely positioned child resolves `top` against the padding box, so
     it would push the CTA down with it. */
  .outro {
    position: relative;
    display: flow-root;
    background: var(--c-bg-light);
  }

  /* --- CTA --------------------------------------------------------------- */

  /* Sits over the seam: the footer's 240px top padding clears its lower half. */
  .cta {
    position: absolute;
    z-index: 2;
    left: 50%;
    top: 0;
    width: var(--content-w);
    height: 416px;
    translate: -50% 0;
    border: 1px solid var(--c-cta-card);
    border-radius: 24px;
    /* Figma builds the ground from a luminosity starfield over a colour
       layer, and a blend needs a known backdrop — `isolate` stops it reaching
       the page behind.
    
       The base is the tint colour rather than the page's light one. Both
       resolve to the same dark purple (luminosity takes the starfield's
       luminance either way), but this one is already correct before the
       lazy-loaded starfield decodes, so the card never flashes light on the
       way in. */
    background: var(--c-heading);
    isolation: isolate;
    overflow: hidden;
  }

  .cta__stars,
  .cta__tint,
  .cta__arcs {
    position: absolute;
    display: block;
    line-height: 0;
  }

  .cta__stars {
    left: calc(50% + 8px);
    top: -14.83px;
    width: 1256px;
    height: 868px;
    translate: -50% 0;
    mix-blend-mode: luminosity;
  }

  .cta__stars :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cta__tint {
    left: 50%;
    top: -1.22px;
    width: var(--content-w);
    height: 531px;
    translate: -50% 0;
    background: var(--c-heading);
    mix-blend-mode: color;
  }

  .cta__arcs {
    left: -484px;
    top: -309px;
    rotate: -90deg;
  }

  .cta__copy {
    position: absolute;
    z-index: 2;
    /* Anchored by its left edge (87.5 in the 1240 card) whatever the width. */
    left: calc(50% - 280.5px + (var(--cta-copy-w, 504px) - 504px) / 2);
    top: calc(50% + 0.24px);
    translate: -50% -50%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    width: var(--cta-copy-w, 504px);
  }

  .cta__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 32px;
    line-height: 40px;
    letter-spacing: -1px;
    color: #fff;
    /* A "\n" in a page's title is a deliberate break (Product Engineering's
       "...better / engineering."); balance alone splits it differently. */
    white-space: pre-line;
  }

  .cta__body {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    letter-spacing: -0.16px;
    color: var(--c-eyebrow-text-dark);
  }

  /* Figma tilts the pill and counter-rotates the arrow so it stays level. */
  .cta__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 48px;
    padding: 8px 16px;
    border-radius: 9999px;
    background: var(--c-accent);
    box-shadow: inset 0 4px 4px rgba(0, 0, 0, 0.25);
    rotate: var(--tilt);
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: var(--fs-body);
    line-height: var(--lh-button);
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
  }

  .cta__btn-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20.226px;
    height: 20.226px;
    rotate: calc(var(--tilt) * -1);
    line-height: 0;
  }

  .cta__btn-arrow :global(svg) {
    /* The badge art carries its own glow bleed either side of the 20px mark. */
    width: 33.2px;
    height: 33.2px;
    max-width: none;
  }

  /* The same states as `PillButton` (see there): deeper purple and a glow on
     hover with the arrow stepping right, the darkest purple pressed in on
     click, an accent ring for keyboard focus. It sits on the dark card, so
     the ring is the light lavender rather than the accent. */
  .cta__btn {
    transition:
      background-color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out),
      scale 0.15s var(--ease-out);
  }

  .cta__btn-arrow {
    transition: translate var(--dur-fast) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .cta__btn:hover {
      background-color: #6c2cfa;
      box-shadow:
        inset 0 4px 4px rgba(0, 0, 0, 0.25),
        0 10px 24px -8px rgba(131, 77, 251, 0.7);
    }

    .cta__btn:hover .cta__btn-arrow {
      translate: 3px 0;
    }
  }

  .cta__btn:active {
    background-color: #5a14f4;
    box-shadow: inset 0 4px 10px rgba(0, 0, 0, 0.38);
    /* `scale`: the reveal leaves an inline transform on this button. */
    scale: 0.97;
    transition-duration: 0.08s;
  }

  .cta__btn:focus-visible {
    outline: 2px solid #c7b0fd;
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .cta__btn:active {
      scale: none;
    }

    .cta__btn:hover .cta__btn-arrow {
      translate: none;
    }
  }

  /* --- card fan ---------------------------------------------------------- */

  .cta__fan {
    position: absolute;
    z-index: 1;
    left: calc(50% + 517.47px);
    top: 59px;
    width: var(--fanW);
    height: var(--fanH);
    translate: -50% 0;
  }

  .cta__card {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--cardW);
    height: var(--cardH);
    overflow: hidden;
    will-change: transform;
  }

  .cta__card :global(img.cta__shot) {
    position: absolute;
    max-width: none;
    pointer-events: none;
  }

  /* --- footer ------------------------------------------------------------ */

  .foot {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--c-bg-footer);
    margin-top: 258px;
  }

  /* No card to clear: the footer starts flush, its content 141 down — the
     1px top rule plus 140, inside Figma's 358. */
  .outro--plain .foot {
    margin-top: 0;
  }

  .outro--plain .foot__top {
    padding-top: 140px;
  }

  .foot__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 64px;
    width: 100%;
    max-width: var(--frame-w);
    margin-inline: auto;
    padding: 240px var(--gutter) 80px;
    border-top: 1px solid #120b23;
  }

  .foot__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    width: 438px;
  }

  .foot__logo {
    position: relative;
    display: block;
    width: 138.732px;
    height: 48px;
    line-height: 0;
  }

  .foot__logo-sub {
    position: absolute;
    left: 71.67%;
    top: 47.14%;
    display: flex;
    flex-direction: column;
    font-family: "Jost", var(--font-sans);
    font-weight: 500;
    font-size: 7.024px;
    line-height: normal;
    color: #fff;
    white-space: nowrap;
  }

  .foot__logo-sub em {
    font-style: normal;
  }

  .foot__tagline {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--c-eyebrow-text-dark);
  }

  .foot__social {
    display: flex;
    align-items: center;
    gap: 23px;
  }

  .foot__social-label {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    text-transform: uppercase;
    color: var(--c-bg-light);
  }

  .foot__social-list {
    display: flex;
    gap: 10px;
    list-style: none;
  }

  /* The Facebook mark is a raster; without this its intrinsic 512px height
     survives `max-width` clamping and it renders as a 32x512 sliver. */
  .foot__social-btn :global(img) {
    width: 14.222px;
    height: 14.222px;
  }

  .foot__social-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--c-bg-light);
    color: #212121;
  }

  .foot__nav {
    display: flex;
    align-items: flex-start;
    gap: 64px;
  }

  .foot__col {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .foot__col--narrow {
    width: 122px;
  }

  .foot__col-title {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    text-transform: uppercase;
    color: var(--c-bg-light);
  }

  /* Figma sets the links at the default leading — a 19px line for 16px
     Inter — so they step 35 apart; at the body's 24 they ran 40 and the
     footer 16 tall. */
  .foot__col ul {
    display: flex;
    flex-direction: column;
    gap: 16px;
    list-style: none;
    line-height: 19px;
  }

  .foot__col a,
  .foot__legal a {
    font-size: var(--fs-body);
    color: var(--c-eyebrow-text-dark);
    text-decoration: none;
    white-space: nowrap;
  }

  .foot__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: var(--frame-w);
    margin-inline: auto;
    /* Figma's rule is an inside stroke: the text sits 40 from the frame's
       top edge, rule included, and the bar is 104 tall. */
    padding: 39px var(--gutter) 40px;
    border-top: 1px solid #333;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--c-eyebrow-text-dark);
  }

  .foot__legal {
    display: flex;
    gap: 32px;
    list-style: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .foot__col a,
    .foot__legal a,
    .foot__social-btn {
      transition: color var(--dur-fast) ease, opacity var(--dur-fast) ease;
    }

    .foot__col a:hover,
    .foot__legal a:hover {
      color: var(--c-bg-light);
    }

    .foot__social-btn:hover {
      opacity: 0.82;
    }
  }

  /* The card is a fixed 1240 centred on the page, so under that width it
     overhangs both edges — at 1100 it sat at left -70 and scrolled the page
     sideways on every page that uses this footer. Fluid below the frame. */
  @media (max-width: 1240px) {
    .cta {
      left: var(--gutter);
      right: var(--gutter);
      width: auto;
      translate: none;
    }

    /* The copy is placed from the card's centre, which only holds while the
       card is 1240: on a fluid card it slid off the left edge (-120 at
       1024). Its left edge is 87.5 into the card at any width, so anchor
       that instead. */
    .cta__copy {
      left: 87.5px;
      translate: 0 -50%;
      /* The fan's left edge sits at 50% + 186 of the card, so on a card
         under ~811 (901-1010 viewports) a 504 copy ran under the
         screenshots. Stop 24 short of it. */
      width: min(var(--cta-copy-w, 504px), calc(50% + 74.5px));
    }
  }

  @media (max-width: 1100px) and (min-width: 901px) {
    .cta__title {
      font-size: 28px;
      line-height: 36px;
    }
  }

  /* ========================================================================
     Mobile — Figma 539:705

     The card narrows to the 361 column and its parts restack: copy centred,
     the screenshot trio underneath it rather than fanned off to one side, and
     the fan stops cycling (the frame draws a static trio, which is what the
     user signed off). The footer keeps the overlap — it simply starts lower.
     ======================================================================== */
  @media (max-width: 900px) {
    .cta {
      left: var(--gutter);
      top: 40px;
      width: auto;
      right: var(--gutter);
      height: 451px;
      translate: none;
      border-radius: 20px;
    }

    /* Relative, not static: a static copy block paints *under* the card's
       absolutely placed starfield and tint, which hid the headline and body
       on every phone and tablet — only the button, which opens its own
       stacking context, showed through. */
    .cta__copy {
      position: relative;
      left: auto;
      top: auto;
      align-items: center;
      gap: 14px;
      width: 100%;
      padding: 40px 24px 0;
      translate: none;
      text-align: center;
    }

    .cta__title {
      font-size: 24px;
      line-height: 32px;
    }

    .cta__body {
      font-size: 14px;
      line-height: 20px;
    }

    .cta__btn {
      margin-top: 12px;
    }

    /* The trio sits under the copy and is centred on the card, not hung off
       its right edge. `cta-fan.ts` leaves it alone at this width. */
    .cta__fan {
      left: 50%;
      top: 307px;
      scale: 0.42;
      transform-origin: top center;
    }

    .foot {
      margin-top: 310px;
    }

    .foot__top {
      flex-direction: column;
      align-items: stretch;
      gap: 24px;
      padding: 229px var(--gutter) 0;
    }

    .foot__brand {
      gap: 16px;
      width: 100%;
    }

    .foot__social {
      flex-wrap: wrap;
      gap: 12px;
    }

    .foot__tagline {
      font-size: 14px;
      line-height: 22px;
    }

    .foot__social-label {
      font-size: 13px;
    }

    .foot__col {
      gap: 12px;
    }

    .foot__col-title {
      font-size: 15px;
      line-height: normal;
    }

    .foot__col ul {
      gap: 10px;
    }

    .foot__col li,
    .foot__col a {
      font-size: 15px;
      line-height: normal;
    }

    /* Capabilities runs full width; Company and Contact share the row under it. */
    .foot__nav {
      flex-wrap: wrap;
      gap: 24px;
    }

    .foot__col:first-child {
      flex: 0 0 100%;
    }

    .foot__col--narrow,
    .foot__col--contact {
      flex: 1 0 0;
      min-width: 0;
    }

    /* The rule and the two centred rows, 32 under the nav and 40 above the
       bottom edge — Figma puts the line at 687 and the block at 719 of 809. */
    .foot__bar {
      flex-direction: column;
      justify-content: center;
      gap: 16px;
      margin-top: 32px;
      padding: 32px var(--gutter) 40px;
      font-size: 14px;
      line-height: normal;
    }

    .foot__legal {
      gap: 24px;
    }
  }

  /* On a phone Company and Contact cannot share a row: the address alone is
     wider than half the column and ran off the screen. Capabilities and
     Company pair up instead, and Contact takes its own row. */
  /* With no card to clear (Contact Us), the desktop's 140 above the footer
     content is a screen's worth of nothing on a phone. The rule above is
     `.outro--plain .foot__top`, which outranks the plain `.foot__top`
     mobile padding, so it is re-pointed with the same selector. */
  @media (max-width: 900px) {
    .outro--plain .foot__top {
      padding-top: 80px;
    }
  }

  @media (max-width: 560px) {
    .outro--plain .foot__top {
      padding-top: 56px;
    }

    .foot__col:first-child {
      flex: 1 0 0;
    }

    .foot__col--contact {
      flex: 0 0 100%;
    }
  }
</style>
