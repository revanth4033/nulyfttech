---
import { getImage } from "astro:assets";
import EyebrowBadge from "../ui/EyebrowBadge.astro";
import { approach } from "../../data/capProductDesign";

/**
 * Our Design Approach — a one-minute motion film of the process, replacing
 * the pinned six-step ring at the user's request: most visitors never
 * stepped through all six states, and the film tells the same story
 * passively, ending on the real products.
 *
 * Laid out to the user's reference: the section's dark band (as the old
 * ring was), the eyebrow and title centred in white, and the film as a
 * contained card centred under them. The reference draws the box wider than
 * the film (~2.4:1); the film is 16:9 and fills its frame, so it keeps its
 * own ratio at the drawn width rather than losing its top and bottom.
 *
 * Playback (all in the script below):
 * - Muted autoplay, looping, only while at least 40% of it is on screen and
 *   the tab is visible; it pauses when scrolled away. Browsers only allow
 *   autoplay muted, so a sound button turns the soundtrack on.
 * - A pause button: motion that runs over five seconds must be stoppable.
 *   A visitor's pause sticks — scrolling back does not restart it.
 * - It is fetched only as the section nears the viewport (`preload="none"`
 *   until then), so the 8.4MB file costs the top of the page nothing.
 * - Under reduced motion it never starts on its own: the poster (the film's
 *   closing collage) shows with the play button.
 * - Without JS the native controls are left on, so it still plays.
 *
 * The six steps the film shows as pictures are kept as text for screen
 * readers and search.
 */
const { film } = approach;
const poster = await getImage({ src: film.poster, width: 1920, format: "webp", quality: 80 });
---

<section class="film" data-section="cap-film">
  <div class="film__inner container">
    <header class="film__head">
      <EyebrowBadge variant="dark" data-animate>{approach.eyebrow}</EyebrowBadge>
      <h2 class="film__title" data-animate>{approach.title}</h2>
    </header>

    <figure class="film__figure" data-film data-animate>
      <div class="film__frame">
      <video
        class="film__video"
        src={film.src}
        poster={poster.src}
        width="1920"
        height="1080"
        muted
        loop
        playsinline
        controls
        preload="none"
        aria-label={film.label}
        data-film-video
      ></video>
      </div>

      <div class="film__controls" hidden data-film-controls>
        <button class="film__btn" type="button" aria-label="Play the film" data-film-play>
          <svg class="film__icon film__icon--play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.6v12.8a.8.8 0 0 0 1.2.7l10.1-6.4a.8.8 0 0 0 0-1.4L9.2 4.9A.8.8 0 0 0 8 5.6Z" /></svg>
          <svg class="film__icon film__icon--pause" viewBox="0 0 24 24" aria-hidden="true"><rect x="6.5" y="5" width="3.6" height="14" rx="1" /><rect x="13.9" y="5" width="3.6" height="14" rx="1" /></svg>
        </button>
        <button class="film__btn" type="button" aria-label="Turn sound on" aria-pressed="false" data-film-sound>
          <svg class="film__icon film__icon--muted" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5h3.2L12 5.4v13.2l-4.8-4.1H4z" /><path d="m15.5 9.5 5 5m0-5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
          <svg class="film__icon film__icon--sound" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5h3.2L12 5.4v13.2l-4.8-4.1H4z" /><path d="M15.4 9a4.2 4.2 0 0 1 0 6M17.9 6.6a7.6 7.6 0 0 1 0 10.8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
        </button>
      </div>
    </figure>

    <ol class="visually-hidden">
      {approach.steps.map((s) => <li>{s.n}. {s.title}: {s.body}</li>)}
    </ol>
  </div>
</section>

<style>
  .film {
    background: var(--c-bg-dark);
    padding-block: 100px;
  }

  .film__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 56px;
  }

  .film__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    max-width: 760px;
    text-align: center;
  }

  .film__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-h2);
    line-height: 1.2;
    letter-spacing: var(--tr-h2);
    color: #fff;
  }

  /* 1094 wide at 1440, the reference's box. Also never so tall that the
     header and the whole film cannot share the screen (on a laptop its foot
     was below the fold), and never wider than the column. */
  .film__figure {
    display: flex;
    flex-direction: column;
    gap: 14px;
    /* 360 = the nav (96) + eyebrow and title (~150) + the gaps (62) + the
       controls row (44), so eyebrow-to-buttons fits under the nav. */
    width: min(100%, 1094px, calc((100svh - 360px) * 16 / 9));
    min-width: min(100%, 640px);
  }

  /* A card on the dark band. Its fill is the film's own lavender, so the
     box reads the same before a byte has loaded as it does playing. */
  .film__frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 16px;
    background: #f5f2ff;
  }

  .film__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: transparent;
  }

  /* --- controls ---------------------------------------------------------- */

  /* Under the film, not on it: there is nothing in the film that a corner
     button is guaranteed not to cover (on a phone they sat on its caption). */
  .film__controls {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
  }

  .film__controls[hidden] {
    display: none;
  }

  .film__btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(245, 243, 255, 0.1);
    box-shadow: inset 0 0 0 1px rgba(245, 243, 255, 0.16);
    color: #fff;
    cursor: pointer;
  }

  @media (hover: hover) and (pointer: fine) {
    .film__btn:hover {
      background: var(--c-accent);
      color: #fff;
    }
  }

  .film__btn:active {
    scale: 0.94;
  }

  .film__btn {
    transition:
      background-color 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      color 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      scale 0.15s var(--ease-out);
  }

  .film__btn:focus-visible {
    outline: 2px solid #c7b0fd;
    outline-offset: 3px;
  }

  .film__icon {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  /* One button, two glyphs: the state class on the frame picks which. */
  .film__icon--pause,
  .film__icon--sound {
    display: none;
  }

  .film__figure.is-playing .film__icon--play,
  .film__figure.is-unmuted .film__icon--muted {
    display: none;
  }

  .film__figure.is-playing .film__icon--pause,
  .film__figure.is-unmuted .film__icon--sound {
    display: block;
  }

  /* --- narrower ---------------------------------------------------------- */

  @media (max-width: 900px) {
    .film {
      padding-block: 64px;
    }

    .film__inner {
      gap: 32px;
    }

    .film__title {
      font-size: 30px;
      letter-spacing: -1px;
    }
  }

  @media (max-width: 560px) {
    .film {
      padding-block: 40px;
    }

    .film__inner {
      gap: 24px;
    }

    .film__head {
      gap: 12px;
    }

    .film__title {
      font-size: 24px;
      letter-spacing: -0.6px;
    }

    .film__figure {
      gap: 10px;
    }

    .film__controls {
      gap: 6px;
    }

    .film__btn {
      width: 36px;
      height: 36px;
    }

    .film__icon {
      width: 16px;
      height: 16px;
    }
  }
</style>

<script>
  import { prefersReducedMotion } from "../../scripts/gsap";

  const frame = document.querySelector<HTMLElement>("[data-film]");
  const video = frame?.querySelector<HTMLVideoElement>("[data-film-video]");
  const controls = frame?.querySelector<HTMLElement>("[data-film-controls]");
  const playBtn = frame?.querySelector<HTMLButtonElement>("[data-film-play]");
  const soundBtn = frame?.querySelector<HTMLButtonElement>("[data-film-sound]");

  if (frame && video && controls && playBtn && soundBtn) {
    const auto = !prefersReducedMotion();
    /** Set only by the visitor's own pause; scrolling away is not a pause. */
    let userPaused = false;
    let inView = false;

    // Our controls replace the native ones once JS is here.
    video.controls = false;
    controls.hidden = false;
    // Autoplaying, the poster would flash the closing collage and then cut
    // to the film's empty opening frame; without it the box is just ground.
    if (auto) video.removeAttribute("poster");

    const sync = () => {
      const playing = !video.paused;
      frame.classList.toggle("is-playing", playing);
      playBtn.setAttribute("aria-label", playing ? "Pause the film" : "Play the film");
      frame.classList.toggle("is-unmuted", !video.muted);
      soundBtn.setAttribute("aria-pressed", String(!video.muted));
      soundBtn.setAttribute("aria-label", video.muted ? "Turn sound on" : "Turn sound off");
    };
    video.addEventListener("play", sync);
    video.addEventListener("pause", sync);
    video.addEventListener("volumechange", sync);

    const play = () => video.play().catch(() => sync());
    const maybePlay = () => {
      if (auto && inView && !userPaused && !document.hidden) play();
    };

    playBtn.addEventListener("click", () => {
      if (video.paused) {
        userPaused = false;
        play();
      } else {
        userPaused = true;
        video.pause();
      }
    });

    soundBtn.addEventListener("click", () => {
      video.muted = !video.muted;
      // Asking for sound is asking to watch.
      if (!video.muted && video.paused) {
        userPaused = false;
        play();
      }
    });

    // Start fetching as the section nears, not on page load.
    new IntersectionObserver(
      ([e], obs) => {
        if (!e.isIntersecting) return;
        video.preload = "auto";
        obs.disconnect();
      },
      { rootMargin: "600px 0px" },
    ).observe(frame);

    new IntersectionObserver(
      ([e]) => {
        inView = e.isIntersecting;
        if (inView) maybePlay();
        else if (!video.paused) video.pause();
      },
      { threshold: 0.4 },
    ).observe(frame);

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) video.pause();
      else maybePlay();
    });

    sync();
  }
</script>
