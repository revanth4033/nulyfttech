---
import HeroBackdrop from "../ui/HeroBackdrop.astro";
import EyebrowBadge from "../ui/EyebrowBadge.astro";

/**
 * The redesign's centred inner-page hero — Studio (667:3303) and About Us
 * (669:3595) draw the same 1440 x 600 frame and differ only in copy. Careers
 * uses it too, by request, with its existing copy (there is no redesigned
 * Careers frame).
 *
 * The home hero's ground (`HeroBackdrop`, its `page` clouds) under one
 * centred 728-wide column: badge, headline with an italic tail, and a
 * paragraph. Figma centres the column on the frame, which puts its top at 200.
 *
 * Contact Us (672:3796) draws it with no italic tail, hence the optional
 * `em`. The frames' fixed heights (600, Contact 554) are no longer used: the
 * hero is sized by its copy with the site's section rhythm under it.
 */
interface Props {
  eyebrow: string;
  title: { lead: string; em?: string };
  /** One entry per line Figma breaks by hand. */
  body: string[];
}

const { eyebrow, title, body } = Astro.props;
---

<section class="phead" data-section="page-hero">
  <HeroBackdrop variant="page" />

  <div class="phead__copy">
    <div class="phead__head">
      <EyebrowBadge variant="studio" data-animate>{eyebrow}</EyebrowBadge>
      <h1 class="phead__title" data-animate>
        {title.lead}{title.em && <em>{title.em}</em>}
      </h1>
    </div>
    <p class="phead__body" data-animate>
      {body.map((line, i) => (i === 0 ? line : [<br />, " ", line]))}
    </p>
  </div>
</section>

<style>
  /* Sized by its copy, not the frame's fixed 600 (554 on Contact): the copy
     sits 80 under the nav card as before, and the band under it is the
     section rhythm — the fixed frame left 175-225px of empty hero there
     (by request: even spacing between sections). */
  .phead {
    position: relative;
    padding: calc(var(--nav-top) + var(--nav-card-h) + 80px) 0 var(--section-y);
    overflow: hidden;
    background: var(--c-bg-light);
  }

  .phead__copy {
    position: relative;
    z-index: var(--z-content);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    width: min(728px, calc(100% - 2 * var(--gutter)));
    text-align: center;
  }

  .phead__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .phead__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-hero);
    line-height: normal;
    letter-spacing: var(--tr-hero-studio);
    color: var(--c-ink);
  }

  .phead__title em {
    /* Set upright at full weight, like the rest of the headline (by
       request — the frame sets this tail italic). */
    font-style: normal;
  }

  .phead__body {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    letter-spacing: var(--tr-body);
    color: var(--c-muted);
  }

  /* --- tablet and phone -------------------------------------------------- */

  /* Narrower, the copy sits a little closer under the nav. Figma's hand-set line breaks are for a 728 column; in a narrow one they
     strand a word or two on a line, so they give way to normal wrapping (the
     space after each break keeps the words apart; at desktop a space at the
     start of a line collapses, so the frame is untouched). */
  @media (max-width: 900px) {
    .phead {
      padding-top: calc(var(--nav-top) + var(--nav-card-h) + 72px);
    }

    .phead__title {
      font-size: 40px;
      letter-spacing: -1.4px;
    }

    .phead__body br {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .phead {
      padding-top: calc(var(--nav-top) + var(--nav-card-h) + 48px);
    }

    .phead__copy {
      gap: 12px;
    }

    .phead__title {
      font-size: 30px;
      line-height: 1.2;
      letter-spacing: -0.8px;
    }

    .phead__body {
      font-size: var(--fs-sm);
      line-height: 22px;
    }
  }
</style>
