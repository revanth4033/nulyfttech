---
/**
 * The header every case-study section below the hero shares — Figma's 1240x84
 * row: eyebrow over title on the left, one intro paragraph on the right, the
 * two vertically centred against each other.
 *
 * **This is not the site's usual section heading.** It is Inter SemiBold 24/32
 * in the body ink, not IBM Plex 32 in the heading ink, and the eyebrow carries
 * a pale pill behind it. Read off 505:4575.
 */
interface Props {
  eyebrow: string;
  title: string;
  body?: string;
  class?: string;
}

const { eyebrow, title, body, class: className } = Astro.props;
---

<header class:list={["chead", className]}>
  <div class="chead__left">
    <p class="chead__eyebrow" data-animate>{eyebrow}</p>
    <h2 class="chead__title" data-animate>{title}</h2>
  </div>

  {body && <p class="chead__body" data-animate>{body}</p>}
</header>

<style>
  .chead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    height: 84px;
    width: 100%;
  }

  .chead__left {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* Vertical padding only — the pill hugs the text horizontally, which is
     what the frame draws. */
  .chead__eyebrow {
    align-self: flex-start;
    padding-block: 8px;
    background: var(--c-case-eyebrow-bg);
    border-radius: 88px;
    font-weight: 500;
    font-size: var(--fs-sm);
    line-height: normal;
    letter-spacing: var(--tr-eyebrow-lg);
    text-transform: uppercase;
    color: var(--c-accent);
  }

  .chead__title {
    width: 525px;
    max-width: 100%;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--fs-lg);
    line-height: 32px;
    color: var(--c-ink);
  }

  .chead__body {
    flex: none;
    width: 503px;
    max-width: 100%;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    letter-spacing: var(--tr-body);
    color: var(--c-muted);
  }

  @media (max-width: 1080px) {
    .chead {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      height: auto;
    }

    .chead__title,
    .chead__body {
      width: auto;
    }
  }
</style>
