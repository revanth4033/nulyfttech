---
import Icon from "./Icon.astro";

/**
 * The pill button from the design.
 *
 * Every pill in the Figma file is rotated -0.65deg with its arrow icon
 * counter-rotated +0.65deg so the glyph stays upright. That tilt is
 * deliberate and appears on all of them, so it lives here rather than
 * being re-applied per instance.
 */
interface Props {
  href?: string;
  variant?: "solid" | "outline";
  /** Arrow glyph size; the solid variant uses the white-disc version. */
  arrow?: false | 16 | 20;
  size?: "md" | "sm";
  block?: boolean;
  /** Solid fill in the flat accent rather than the gradient (capability heroes). */
  flat?: boolean;
  /** Override the arrow glyph, e.g. the 20px outline circle the capability pages use. */
  arrowIcon?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = "solid",
  arrow = false,
  size = "md",
  block = false,
  flat = false,
  arrowIcon,
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? "a" : "button";
const iconName =
  arrowIcon ?? (variant === "solid" ? "icons/arrow-circle-20" : "icons/arrow-circle-16");
---

<Tag
  href={href}
  type={href ? undefined : "button"}
  class:list={["pill", `pill--${variant}`, `pill--${size}`, { "pill--block": block, "pill--flat": flat }, className]}
  {...rest}
>
  <span class="pill__inner">
    <span class="pill__label"><slot /></span>
    {arrow && <Icon name={iconName} size={arrow} class="pill__arrow" />}
  </span>
</Tag>

<style>
  .pill {
    position: relative;
    /* The state layer below sits behind the label but over the pill's own
       fill; isolation keeps its z-index: -1 inside the pill. */
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding: 8px 16px;
    border-radius: var(--r-pill);
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: var(--fs-body);
    line-height: var(--lh-button);
    white-space: nowrap;
    rotate: var(--tilt);
    transition:
      scale 0.15s var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  /* --- states -------------------------------------------------------------
     Brand purples only: #834dfb (accent) -> #7437fb -> #6624fa -> #4e05ef,
     and the lavender tints for the outline. A gradient cannot transition,
     so each state's fill is a layer under the label that fades in.

     hover    solid: a deeper gradient + a soft purple glow; outline: the
              lavender tint, border and label deepen; the arrow steps right
     pressed  solid: the darkest purple, the glow gone and the inset shadow
              deeper — pressed in; outline: a stronger tint; both shrink 3%
     focus    a 2px accent ring, keyboard only

     Hover is fine-pointer only, so a tap never leaves a phone button stuck
     in its hover colour. */
  .pill::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  .pill--solid::before {
    background: linear-gradient(100.43deg, #7437fb 0%, #6624fa 55%, #5a14f4 100%);
  }

  .pill--flat::before {
    background: #6c2cfa;
  }

  /* The chip tint, not the eyebrow's #f3eeff — that is two levels off the
     page's lavender ground and barely showed. */
  .pill--outline::before {
    background: var(--c-accent-tint);
  }

  .pill :global(.pill__arrow) {
    transition: translate var(--dur-fast) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .pill:hover::before {
      opacity: 1;
    }

    .pill--solid:hover {
      box-shadow:
        var(--sh-button-inset),
        0 10px 22px -8px rgba(102, 36, 250, 0.6);
    }

    .pill--outline:hover {
      border-color: #6624fa;
      color: #6624fa;
    }

    .pill:hover :global(.pill__arrow) {
      translate: 3px 0;
    }
  }

  /* `scale`, not `transform`: a pill that carries a scroll reveal keeps an
     inline transform afterwards, which would silently win over this. */
  .pill:active {
    scale: 0.97;
  }

  .pill:active::before {
    opacity: 1;
    transition-duration: 0.08s;
  }

  .pill--solid:active::before {
    background: linear-gradient(100.43deg, #6624fa 0%, #5a14f4 55%, #4e05ef 100%);
  }

  .pill--flat:active::before {
    background: #5a14f4;
  }

  .pill--solid:active {
    box-shadow: inset 0 4px 10px rgba(0, 0, 0, 0.38);
  }

  .pill--outline:active::before {
    background: #dccdfe;
  }

  .pill--outline:active {
    border-color: #4e05ef;
    color: #4e05ef;
  }

  .pill:focus-visible {
    outline: 2px solid var(--c-accent);
    outline-offset: 3px;
  }

  .pill--sm {
    height: 40px;
    font-size: var(--fs-sm);
  }

  .pill--block {
    display: flex;
    width: 100%;
  }

  .pill__inner {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  /* Counter-rotate the glyph so it reads upright inside the tilted pill. */
  .pill :global(.pill__arrow) {
    rotate: calc(-1 * var(--tilt));
  }

  .pill--solid {
    background-image: var(--grad-pill);
    color: #fff;
    box-shadow: var(--sh-button-inset);
  }

  .pill--flat {
    background-image: none;
    background-color: var(--c-accent);
  }

  .pill--outline {
    border: 1px solid var(--c-accent);
    color: var(--c-accent);
    background: transparent;
  }

  /* Colour still answers the pointer under reduced motion; nothing moves. */
  @media (prefers-reduced-motion: reduce) {
    .pill:active {
      scale: none;
    }

    .pill:hover :global(.pill__arrow) {
      translate: none;
    }
  }
</style>
