---
import EyebrowBadge from "../ui/EyebrowBadge.astro";
import { Image } from "astro:assets";
import { overview } from "../../data/caseAuto";

/**
 * Overview and Challenge — Figma 510:5776 and 510:5815.
 *
 * Both are a copy column beside media inside a 1240 container inset 100 from
 * the frame, so they share a file the way the LMS pair does.
 *
 * Both eyebrows are the site's shared `EyebrowBadge` (by request). The
 * frames draw Overview's as bare text and the Challenge's as a pale pill;
 * every case-study eyebrow now matches the rest of the site instead.
 */
/**
 * Figma insets the 1240 container 100 from the frame on every side, and that
 * inset is the frame's padding here — so absolutely positioned children, whose
 * containing block is the frame's *border* box, have to add it back. Without
 * this every piece of media sits 100px high.
 */
const INSET = 100;

const ov = overview;
---

<section class="aov" data-section>
  <div class="aov__frame">
    <span class="aglow" style="left:749px;top:148px;width:400px;height:400px" aria-hidden="true"></span>

    <div class="aov__copy">
      <EyebrowBadge class="case-eyebrow" data-animate>{ov.eyebrow}</EyebrowBadge>
      <h2 class="aov__title" data-animate>{ov.title}</h2>
      <p class="aov__body" data-animate>{ov.body}</p>

      <ul class="aov__modules" data-animate>
        {
          ov.modules.map((m) => (
            <li>
              <span class="aov__diamond" aria-hidden="true" />
              {m}
            </li>
          ))
        }
      </ul>

      <dl class="aov__facts" data-animate>
        {
          ov.facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <Image
      src={ov.phone.src}
      alt="Marketplace listings screen on a phone"
      width={ov.phone.w * 2}
      widths={[ov.phone.w, ov.phone.w * 2]}
      sizes={`${ov.phone.w}px`}
      class="aov__phone"
      style={`left:${ov.phone.x}px;top:${ov.phone.y + INSET}px;width:${ov.phone.w}px`}
      data-animate
    />
  </div>
</section>

<style>
  /* The shared section eyebrow (by request — the case studies had their own
     pale, untracked-padding pill). It is inline-flex, so in these column
     layouts it would stretch the full width without this. */
  :global(.case-eyebrow) {
    align-self: flex-start;
  }

  .aov {
    position: relative;
    background: var(--c-bg-light);
  }

  /* Figma insets a 1240 container by 100 on every side. */
  .aov__frame {
    position: relative;
    width: 100%;
    max-width: 1240px;
    margin-inline: auto;
    padding-block: 100px;
  }

  .aov__frame {
    height: 698px;
  }

  .aov__copy {
    position: absolute;
    top: 100px;
    left: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .aov__copy {
    width: 606px;
  }

  .aov__title {
    margin-top: 8px;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--fs-lg);
    line-height: 32px;
    color: var(--c-ink);
  }

  .aov__body {
    margin-top: 24px;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--c-muted);
  }

  /* 541 wide with a 16px gap, items sized to content — which is what makes
     the second row break after "Dashboard Analytics" the way Figma draws it. */
  .aov__modules {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    width: 541px;
    max-width: 100%;
    margin-top: 24px;
  }

  .aov__modules li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 500;
    font-size: var(--fs-md);
    line-height: var(--lh-card);
    color: var(--c-ink);
    white-space: nowrap;
  }

  .aov__diamond {
    width: 16px;
    height: 16px;
    rotate: 45deg;
    background: var(--c-accent);
  }

  /* Three facts, content-sized, 32px apart. */
  .aov__facts {
    display: flex;
    gap: 32px;
    margin-top: 24px;
  }

  .aov__facts dt {
    font-size: var(--fs-sm);
    line-height: normal;
    letter-spacing: var(--tr-eyebrow-md);
    text-transform: uppercase;
    color: var(--c-muted);
    white-space: nowrap;
  }

  .aov__facts dd {
    margin-top: 8px;
    font-weight: 500;
    font-size: var(--fs-md);
    letter-spacing: var(--tr-eyebrow-sm);
    color: var(--c-accent);
    white-space: nowrap;
  }

  .aov__phone {
    position: absolute;
    display: block;
    height: auto;
    max-width: none;
  }

  /* Figma gives the first row no top padding — it sits straight under the
     paragraph and only the rule below it separates the four. */

  /* The soft lavender disc behind the media. Faint on purpose: measured on
     the frame it bottoms out 5-6 levels under the ground. */
  .aglow {
    position: absolute;
    z-index: 0;
    border-radius: 50%;
    background: var(--c-accent-glow);
    filter: blur(90px);
    opacity: 0.16;
  }

  @media (max-width: 1280px) {
    .aov__frame {
      height: auto;
      padding-inline: var(--gutter);
    }

    .aov__copy {
      position: static;
      width: 100%;
      max-width: 606px;
    }

    .aov__phone {
      position: static;
      width: 100% !important;
      max-width: 651px;
      /* These were placed by `left` on desktop; once they join the flow that
         stops applying and a capped width leaves them hard against the left
         gutter. */
      margin: 48px auto 0;
    }

    .aglow {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .aov__frame {
      padding-block: 64px;
    }

    .aov__title {
      font-size: 22px;
      line-height: 30px;
    }

    .aov__body {
      font-size: 15px;
      line-height: 24px;
    }
  }

  /* Mobile */
  @media (max-width: 560px) {
    .aov__frame {
      padding-block: 40px;
    }

    .aov__title {
      font-size: 20px;
      line-height: 28px;
    }

    .aov__body {
      font-size: 14px;
      line-height: 22px;
    }

    /* A 32px flex row of four facts cannot hold a 341 column. */
    .aov__facts {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px 16px;
    }

    .aov__facts dt {
      font-size: 11px;
      letter-spacing: 1.2px;
    }

    /* The fact labels and values are `nowrap` so they hold one line in a
       desktop column. In a 171px mobile track "Automotive Marketplace" is
       wider than its cell and simply ran over the next one — the grid was
       right, the nowrap was not. */
    .aov__facts dt,
    .aov__facts dd {
      white-space: normal;
    }

    .aov__facts dd {
      font-size: 16px;
      line-height: 24px;
    }

    .aov__modules {
      font-size: 14px;
    }

    /* At 15/2.4 the longest point wrapped and closed the gap to its rule. */
  }
</style>
