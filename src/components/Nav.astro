---
import Icon from "../components/ui/Icon.astro";
import PillButton from "./ui/PillButton.astro";

/**
 * Site navigation — Figma 664:2984, from the redesigned home page (664:2977).
 *
 * A floating card rather than a full-width bar: 1240 x 72, 48px down, radius
 * 14, on the light ground with a soft purple drop. Its three children are
 * spaced by `justify-content: space-between`, which is what puts the link row
 * at x=297.64 in the frame — the row is not centred on the card.
 *
 * Capabilities carries a chevron in the design but no open state. The menu
 * under it is ours: the three capability pages, in the order the footer lists
 * them.
 *
 * "Get Started" opens the Contact Us page.
 */
const capabilities = [
  { label: "Product Design", href: "/product-design" },
  { label: "Product Engineering", href: "/product-engineering" },
  { label: "AI & Automation", href: "/ai-automation" },
];

type Link = { label: string; href: string } | { label: string; menu: typeof capabilities };

const links: Link[] = [
  { label: "Home", href: "/" },
  { label: "Work", href: "/studio" },
  { label: "Capabilities", menu: capabilities },
  { label: "About us", href: "/about" },
  { label: "Careers", href: "/careers" },
];

/** Mark the page we are on, for both styling and assistive tech. */
const here = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) => !href.includes("#") && (href.replace(/\/$/, "") || "/") === here;
const inMenu = capabilities.some((c) => isCurrent(c.href));
---

<header class="nav" data-nav>
  <div class="nav__inner">
    <a class="nav__logo" href="/" aria-label="nuLyft technologies — home">
      <Icon name="brand/nulyft-logo" width={64.72} height={32.36} />
    </a>

    <nav class="nav__links" aria-label="Primary">
      <ul>
        {
          links.map((l) =>
            "menu" in l ? (
              <li class="nav__menu" data-nav-menu>
                <button
                  class:list={["nav__link", "nav__menu-btn", { "is-current": inMenu }]}
                  type="button"
                  aria-expanded="false"
                  aria-controls="nav-capabilities"
                  data-nav-menu-btn
                >
                  <span class="nav__label">{l.label}</span>
                  <Icon name="icons/home/chevron" size={20} class="nav__chevron" />
                </button>
                <ul class="nav__sub" id="nav-capabilities">
                  {l.menu.map((m) => (
                    <li>
                      <a href={m.href} aria-current={isCurrent(m.href) ? "page" : undefined}>
                        {m.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a class="nav__link" href={l.href} aria-current={isCurrent(l.href) ? "page" : undefined}>
                  <span class="nav__label">{l.label}</span>
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <PillButton href="/contact" variant="outline" class="nav__cta">Get started</PillButton>

    <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-menu" data-nav-toggle>
      <span class="visually-hidden">Menu</span>
      <span class="nav__bars" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>

  <div class="nav__drawer" id="nav-menu" data-nav-drawer hidden>
    <ul>
      {
        links.map((l) =>
          "menu" in l ? (
            <li class="nav__drawer-group">
              <span class="nav__drawer-label">{l.label}</span>
              <ul>
                {l.menu.map((m) => (
                  <li>
                    <a href={m.href} aria-current={isCurrent(m.href) ? "page" : undefined}>
                      {m.label}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a href={l.href} aria-current={isCurrent(l.href) ? "page" : undefined}>
                {l.label}
              </a>
            </li>
          ),
        )
      }
    </ul>
    <PillButton href="/contact" variant="outline">Get started</PillButton>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    z-index: var(--z-nav);
    top: var(--nav-top);
    left: 50%;
    width: min(var(--content-w), calc(100% - 2 * var(--gutter)));
    translate: -50% 0;
    background: var(--c-bg-light);
    border-radius: var(--r-nav);
    box-shadow: var(--sh-nav-card);
    transition: translate 0.45s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Hidden while scrolling down (see the script): lifted past its own top
     offset and its shadow, so nothing of it shows. */
  .nav.is-hidden {
    translate: -50% calc(-100% - var(--nav-top) - 24px);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-card-h);
    padding: 12px 24px;
  }

  /* --- logo -------------------------------------------------------------- */

  /* The logo frame also holds a "technologies / Pvt Ltd" lockup, but it sits
     at 102.33% across a frame that clips — Figma never shows it, so it is
     left out. */
  .nav__logo {
    position: relative;
    display: block;
    flex: none;
    width: 64.78px;
    height: 32px;
    line-height: 0;
  }

  /* --- links ------------------------------------------------------------- */

  .nav__links > ul {
    display: flex;
    align-items: center;
    gap: 40px;
    padding: 8px 16px;
  }

  .nav__link {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: var(--fs-body);
    line-height: normal;
    /* Figma tracks these 2px; the user asked for normal spacing. Set as
       typed — sentence case ("About us"), by request; no capitalize. */
    color: var(--c-ink);
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease-out);
  }

  /* The current page is set heavier, in the accent, and underlined. */
  .nav__link[aria-current="page"],
  .nav__link.is-current {
    font-weight: 600;
    color: var(--c-accent);
    text-decoration: underline;
    text-decoration-thickness: from-font;
    text-underline-position: from-font;
  }

  .nav__link:hover,
  .nav__menu-btn[aria-expanded="true"] {
    color: var(--c-accent);
  }

  .nav__link :global(.nav__chevron) {
    flex: none;
    transition: rotate var(--dur-fast) var(--ease-out);
  }

  .nav__menu-btn[aria-expanded="true"] :global(.nav__chevron) {
    rotate: 180deg;
  }

  /* --- capabilities menu ------------------------------------------------- */

  .nav__menu {
    position: relative;
  }

  /* 26 brings the panel to the bar's foot; the extra 12 stands it off the
     bar (by request — it touched). */
  .nav__sub {
    position: absolute;
    top: calc(100% + 26px + 12px);
    left: -16px;
    display: grid;
    gap: 4px;
    min-width: 240px;
    padding: 8px;
    background: var(--c-surface);
    border-radius: 12px;
    box-shadow: var(--sh-nav-card), 0 0 0 1px var(--c-perk-border);
    opacity: 0;
    visibility: hidden;
    translate: 0 -6px;
    transition:
      opacity var(--dur-fast) var(--ease-out),
      translate var(--dur-fast) var(--ease-out),
      visibility 0s linear var(--dur-fast);
  }

  /* An invisible bridge over that 12px gap, so the pointer crossing from
     "Capabilities" to the panel never leaves the menu on the way. */
  .nav__sub::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    height: 40px;
  }

  .nav__menu-btn[aria-expanded="true"] + .nav__sub {
    opacity: 1;
    visibility: visible;
    translate: 0 0;
    transition-delay: 0s;
  }

  .nav__sub a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 12px;
    border-radius: 8px;
    font-weight: 500;
    font-size: var(--fs-body);
    line-height: normal;
    color: var(--c-ink);
    white-space: nowrap;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  /* Hover and the current page must not look alike (the user caught the
     two lavender rows reading as one block): hover is a neutral grey, the
     current page keeps the lavender and purple with a dot at its end. */
  .nav__sub a:hover,
  .nav__sub a:focus-visible {
    background: var(--c-menu-hover);
  }

  .nav__sub a[aria-current="page"] {
    background: var(--c-eyebrow-bg);
    color: var(--c-accent);
  }

  .nav__sub a[aria-current="page"]::after {
    content: "";
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c-accent);
  }

  /* --- CTA --------------------------------------------------------------- */

  .nav :global(.nav__cta) {
    flex: none;
    height: 44px;
  }

  /* --- narrow ------------------------------------------------------------ */

  .nav__toggle {
    display: none;
    width: 44px;
    height: 44px;
    place-items: center;
  }

  .nav__bars {
    display: grid;
    gap: 6px;
  }

  .nav__bars i {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--c-ink);
    border-radius: 2px;
  }

  .nav__drawer {
    display: none;
    flex-direction: column;
    gap: 20px;
    padding: 4px 24px 24px;
  }

  .nav__drawer ul {
    display: grid;
    gap: 4px;
  }

  /* Scoped to the list, not `.nav__drawer a` — `PillButton` renders an `<a>`
     when it carries an href, so the bare selector would catch the CTA too. */
  .nav__drawer ul a {
    display: block;
    padding: 10px 0;
    font-weight: 500;
    color: var(--c-ink);
  }

  .nav__drawer ul a[aria-current="page"] {
    color: var(--c-accent);
  }

  /* Capabilities keeps its grouping in the drawer: a small label over its
     three pages, indented, so they do not read as three more top-level
     links. */
  .nav__drawer-label {
    display: block;
    padding: 10px 0 2px;
    font-weight: 500;
    font-size: var(--fs-xs);
    color: var(--c-muted);
  }

  .nav__drawer-group ul {
    padding-left: 12px;
    border-left: 1px solid var(--c-perk-border);
    margin-block: 4px;
  }

  @media (max-width: 1080px) {
    .nav__links,
    .nav :global(.nav__cta) {
      display: none;
    }

    .nav__toggle {
      display: grid;
    }

    .nav__drawer {
      display: flex;
    }

    .nav__drawer[hidden] {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .nav__inner {
      padding: 8px 12px 8px 16px;
    }

    .nav__drawer {
      padding: 0 16px 20px;
    }
  }
</style>

<script>
  /* Hide on scroll down, show on scroll up (by request). It always shows
     near the top of the page, and a mouse at the top edge — or over the bar
     — brings it in without scrolling. It stays while the phone menu or the
     Capabilities menu is open, or while keyboard focus is inside it, so it
     never leaves under someone using it. ScrollSmoother keeps the native
     scroll position, so window scroll events are the source. */
  const bar = document.querySelector<HTMLElement>("[data-nav]");
  if (bar) {
    const TOP = 120; // always shown above this
    const DELTA = 6; // ignore smaller wobbles
    const ZONE = 96; // pointer this close to the top reveals it
    const fine = window.matchMedia("(hover: hover) and (pointer: fine)");
    let lastY = window.scrollY;
    let hidden = false;
    let peek = false;
    let ticking = false;
    /** Last mouse position; scrolling does not move the pointer, so the
        reveal is re-checked against it on scroll. */
    let pointerY = Infinity;
    let overBar = false;

    // Keyboard focus only: a mouse click leaves focus on whatever was
    // clicked, and holding on that pinned the bar after any click.
    const held = () =>
      bar.querySelector(":focus-visible") !== null ||
      bar.querySelector('[aria-expanded="true"]') !== null;

    const apply = () => bar.classList.toggle("is-hidden", hidden && !peek && !held());

    const onScroll = () => {
      ticking = false;
      const y = window.scrollY;
      if (y < TOP) {
        hidden = false;
        lastY = y;
      } else if (Math.abs(y - lastY) > DELTA) {
        hidden = y > lastY;
        lastY = y;
      }
      // A peek lasts while the mouse stays at the top or on the bar — the
      // bar never slides out from under the cursor.
      peek = fine.matches && (pointerY < ZONE || overBar);
      apply();
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(onScroll);
        }
      },
      { passive: true },
    );

    document.addEventListener("pointermove", (e) => {
      if (e.pointerType !== "mouse" || !fine.matches) return;
      pointerY = e.clientY;
      overBar = bar.contains(e.target as Node);
      const next = pointerY < ZONE || overBar;
      if (next !== peek) {
        peek = next;
        apply();
      }
    });

    document.documentElement.addEventListener("mouseleave", () => {
      pointerY = Infinity;
      overBar = false;
      peek = false;
      apply();
    });

    // Opening a menu or tabbing in holds it; closing lets it go again.
    bar.addEventListener("focusin", apply);
    bar.addEventListener("focusout", () => requestAnimationFrame(apply));
    new MutationObserver(apply).observe(bar, { subtree: true, attributes: true, attributeFilter: ["aria-expanded"] });
  }
</script>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const drawer = document.querySelector<HTMLElement>("[data-nav-drawer]");

  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    if (drawer) drawer.hidden = open;
  });

  // Close the drawer after following an in-page link.
  drawer?.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) {
      toggle?.setAttribute("aria-expanded", "false");
      drawer.hidden = true;
    }
  });

  /* Capabilities menu: opens on hover for a mouse, on click/Enter for
     everything else, and closes on Escape, an outside click, or focus
     leaving it. */
  const menu = document.querySelector<HTMLElement>("[data-nav-menu]");
  const btn = menu?.querySelector<HTMLButtonElement>("[data-nav-menu-btn]");

  if (menu && btn) {
    const set = (open: boolean) => btn.setAttribute("aria-expanded", String(open));
    const isOpen = () => btn.getAttribute("aria-expanded") === "true";
    const hover = window.matchMedia("(hover: hover) and (pointer: fine)");
    let closeTimer = 0;

    btn.addEventListener("click", () => set(!isOpen()));

    menu.addEventListener("pointerenter", (e) => {
      if (e.pointerType !== "mouse" || !hover.matches) return;
      window.clearTimeout(closeTimer);
      set(true);
    });

    menu.addEventListener("pointerleave", (e) => {
      if (e.pointerType !== "mouse" || !hover.matches) return;
      // A short grace period so the pointer can cross the gap to the panel.
      closeTimer = window.setTimeout(() => set(false), 160);
    });

    menu.addEventListener("focusout", (e) => {
      if (!menu.contains(e.relatedTarget as Node | null)) set(false);
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen()) {
        set(false);
        btn.focus();
      }
    });

    document.addEventListener("click", (e) => {
      if (isOpen() && !menu.contains(e.target as Node)) set(false);
    });
  }
</script>
