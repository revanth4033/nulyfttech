---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import PeHero from "../components/sections/PeHero.astro";
import PeServices from "../components/sections/PeServices.astro";
import PeProcess from "../components/sections/PeProcess.astro";
import PeProof from "../components/sections/PeProof.astro";
import CtaFooter from "../components/sections/CtaFooter.astro";
import { cta } from "../data/capProductEngineering";
---

<BaseLayout
  title="Product Engineering — nuLyft"
  description="Building products around business requirements: we take products from initial design through development and delivery, with each stage guided by the business's needs."
>
  <Nav slot="overlay" />

  <PeHero />
  <PeServices />
  <PeProcess />
  <PeProof />
  <CtaFooter title={cta.title} body={cta.body} button={cta.button} />
</BaseLayout>

<script>
  import "../scripts/reveal.ts";
  import "../scripts/fit.ts";
  import "../scripts/anchors.ts";
  import "../scripts/cta-fan.ts";
  import "../scripts/pe-hero.ts";
  import "../scripts/pe-services.ts";
</script>
