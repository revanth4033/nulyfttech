---
import EyebrowBadge from "../ui/EyebrowBadge.astro";
/**
 * The header every case-study section below the hero shares — Figma's 1240x84
 * row: eyebrow over title on the left, one intro paragraph on the right, the
 * two vertically centred against each other.
 *
 * **This is not the site's usual section heading.** It is Inter SemiBold 24/32
 * in the body ink, not IBM Plex 32 in the heading ink, and the eyebrow carries
 * a pale pill behind it. Read off 505:4575.
 */
interface Props {
  eyebrow: string;
  title: string;
  body?: string;
  class?: string;
}

const { eyebrow, title, body, class: className } = Astro.props;
---

<header class:list={["chead", className]}>
  <div class="chead__left">
    <EyebrowBadge class="case-eyebrow" data-animate>{eyebrow}</EyebrowBadge>
    <h2 class="chead__title" data-animate>{title}</h2>
  </div>

  {body && <p class="chead__body" data-animate>{body}</p>}
</header>

<style>
  /* The shared section eyebrow (by request — the case studies had their own
     pale, untracked-padding pill). It is inline-flex, so in these column
     layouts it would stretch the full width without this. */
  :global(.case-eyebrow) {
    align-self: flex-start;
  }

  .chead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    height: 84px;
    width: 100%;
  }

  .chead__left {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }


  .chead__title {
    width: 525px;
    max-width: 100%;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--fs-lg);
    line-height: 32px;
    color: var(--c-ink);
  }

  .chead__body {
    flex: none;
    width: 503px;
    max-width: 100%;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    letter-spacing: var(--tr-body);
    color: var(--c-muted);
  }

  /* Between 1080 and 1240 the row is still side by side, but its two columns
     are rigid — 525 + 32 + 503 = 1060 against an 896 content width at 1100 —
     so the intro ran 64px past the section. It used to scroll the page; with
     the sections clipping their shadow bleed it would silently truncate
     instead. Let both columns shrink, and drop the fixed height, because a
     narrower title takes a second line. */
  @media (max-width: 1240px) {
    .chead {
      height: auto;
      min-height: 84px;
    }

    .chead__left,
    .chead__body {
      flex: 1 1 0;
      min-width: 0;
      width: auto;
    }

    .chead__title {
      width: auto;
    }
  }

  @media (max-width: 1080px) {
    .chead {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      height: auto;
    }

    .chead__title,
    .chead__body {
      width: auto;
    }
  }

  /* Tablet — the header has already stacked by here (1080), so this is the
     first scale step; 560 below is the phone one. */
  @media (max-width: 900px) {
    .chead__title {
      font-size: 22px;
      line-height: 30px;
    }

    .chead__body {
      font-size: 15px;
      line-height: 24px;
    }
  }

  /* Mobile — this header sits above every block on all three case studies, so
     it sets the page's scale. At 24/16 it read larger than the 20px heading
     the rest of the site uses on a phone. */
  @media (max-width: 560px) {
    .chead {
      gap: 12px;
    }

    .chead__title {
      font-size: 20px;
      line-height: 28px;
    }

    .chead__body {
      font-size: 14px;
      line-height: 22px;
    }

  }
</style>
