---
import ProjectCard from "../studio/ProjectCard.astro";
import { projects } from "../../data/studio";

/**
 * Studio case studies — Figma 667:3345, 1440 x 1528.
 *
 * Two half-width cards side by side, then the Automotive card across the
 * full column. The redesign has no filter tabs: every project here has its
 * own case-study page.
 */
---

<section class="projects" id="projects">
  <div class="container projects__grid">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
</section>

<style>
  .projects {
    position: relative;
    padding-block: var(--section-y);
    background: var(--c-bg-light);
  }

  .projects__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 120px 16px;
    align-items: start;
  }

  /* 40 is the block rhythm the home page's mobile frames use throughout. */
  @media (max-width: 900px) {

    .projects__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 64px;
    }
  }

  /* The grid's last row carries 20px of its own below the cards. */
  @media (min-width: 1241px) {
    .projects {
      padding-bottom: calc(var(--section-y) - 20px);
    }
  }
</style>
