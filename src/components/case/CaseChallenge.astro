---
import CaseHeader from "./CaseHeader.astro";
import ChallengeArt from "./ChallengeArt.astro";
import type { ChallengeCard } from "./challenge-art";

/**
 * The case studies' challenge section — redesigned at the user's request.
 * The frames pair a red uppercase ✕ list with a collage of AI-generated
 * photos, which read as off-brand against the rest of the site. Two layouts
 * were tried on the Recruitment page; this one (B) was chosen and now serves
 * all three case studies (A — copy beside icon cards — is deleted).
 *
 * The case studies' own section header — eyebrow and title left, intro
 * right — over one wide panel split into four columns by hairlines. Each
 * column opens on a small picture of the pain, drawn in the site's product-UI
 * language (lavender tiles, hairlines, the accent) rather than a photo:
 * see `ChallengeArt` — then the number, the challenge and what it cost.
 * The "what it cost" lines are our copy, written from each page's story.
 *
 * The hairlines are the panel's own fill showing through a 1px grid gap, so
 * they stay correct at four, two or one column. The pictures are decorative
 * (`aria-hidden`); the text carries the meaning.
 */
interface Props {
  eyebrow: string;
  title: string;
  body: string;
  cards: readonly ChallengeCard[];
}

const { eyebrow, title, body, cards } = Astro.props;
---

<section class="cchb" data-section="case-challenge">
  <div class="container cchb__inner">
    <CaseHeader eyebrow={eyebrow} title={title} body={body} />

    <ol class="cchb__panel" data-animate>
      {
        cards.map((c, i) => (
          <li class="cchb__col">
            <div class="cchb__art" aria-hidden="true">
              <ChallengeArt kind={c.art} />
            </div>

            <span class="cchb__n">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="cchb__title">{c.title}</h3>
            <p class="cchb__body">{c.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .cchb {
    background: var(--c-bg-light);
    padding-block: 100px;
  }

  .cchb__inner {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  /* --- the panel ----------------------------------------------------------
     The 1px gap shows the panel's lavender fill: hairlines between the
     columns at any column count. */
  .cchb__panel {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    border: 1px solid rgba(131, 77, 251, 0.2);
    border-radius: 24px;
    background: rgba(131, 77, 251, 0.16);
    list-style: none;
  }

  .cchb__col {
    display: flex;
    flex-direction: column;
    padding: 24px 24px 28px;
    background: var(--c-surface);
  }

  .cchb__art {
    display: grid;
    place-items: center;
    height: 140px;
    margin-bottom: 24px;
    overflow: hidden;
    border-radius: 14px;
    background: #f8f5ff;
    box-shadow: inset 0 0 0 1px rgba(131, 77, 251, 0.1);
  }

  .cchb__n {
    font-weight: 500;
    font-size: var(--fs-sm);
    font-variant-numeric: tabular-nums;
    color: var(--c-accent);
  }

  .cchb__title {
    margin-top: 8px;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 18px;
    line-height: 24px;
    color: var(--c-ink);
  }

  .cchb__body {
    margin-top: 8px;
    font-size: var(--fs-sm);
    line-height: 22px;
    color: var(--c-muted);
  }

  /* --- narrower ---------------------------------------------------------- */

  @media (max-width: 1180px) {
    .cchb__panel {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .cchb {
      padding-block: 64px;
    }

    .cchb__inner {
      gap: 32px;
    }
  }

  @media (max-width: 560px) {
    .cchb {
      padding-block: 40px;
    }

    .cchb__panel {
      grid-template-columns: minmax(0, 1fr);
      border-radius: 20px;
    }

    .cchb__col {
      padding: 20px;
    }

    .cchb__art {
      height: 124px;
      margin-bottom: 16px;
    }

    .cchb__title {
      font-size: var(--fs-body);
      line-height: 22px;
    }
  }
</style>
