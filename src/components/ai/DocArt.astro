---
/**
 * Document & Data Intelligence illustration — Figma 647:6532.
 *
 * A document (lines of placeholder text, three passages marked 1-3) wired
 * by dashed connectors to three extracted fields. Static, it renders the
 * frame: every field filled. `ai-doc.ts` plays it as an extraction — a
 * scan line runs down the page, and as it crosses each marked passage the
 * connector to that field lights, a pulse runs along it, and the field's
 * value types in.
 *
 * Geometry is Figma's, in the 412 x 211 block the frame centres.
 *
 * On a narrow panel (<= 700) the block closes up to 330 rather than
 * scaling: the document — placeholder lines only, no text to lose — draws
 * at 0.76 from its left-middle, the connector SVG slides 41px left with it
 * untouched (a pure translate, so the pulse dots stay round), and the
 * fields narrow from 191 to 150, which their values still fit.
 */
import { services } from "../../data/capAi";

const d = services.doc;

// Placeholder text lines: [x, y, w] inside the 170 x 211 document.
const lines: [number, number, number][] = [
  [107, 19, 50],
  [11, 55, 107],
  [11, 71, 146],
  [11, 81, 146],
  [11, 91, 146],
  [11, 101, 146],
  [11, 133, 107],
  [11, 149, 146],
  [11, 159, 107],
];

// The three marked passages: box position and its number badge.
const marks = [
  { x: 11, y: 39, bx: 7, by: 35 },
  { x: 11, y: 117, bx: 7, by: 113 },
  { x: 71, y: 185, bx: 67, by: 181 },
];

// Doc -> field connectors, block coordinates. The outer two bracket up and
// down from the document's mid-edge; the middle one runs straight across.
const paths = [
  "M172 102.3H187.5C191.92 102.3 195.5 98.72 195.5 94.3V64.3C195.5 59.88 199.08 56.3 203.5 56.3H220",
  "M172 102.3L221 102.8",
  "M172 102.3H187.5C191.92 102.3 195.5 105.88 195.5 110.3V148.3C195.5 152.72 199.08 156.3 203.5 156.3H220",
];
---

<div class="doc" data-doc>
  <div class="doc__block">
    <div class="doc__page" data-doc-page>
      <span class="doc__logo"></span>
      {lines.map(([x, y, w]) => <span class="doc__line" style={`left:${x}px;top:${y}px;width:${w}px`} />)}
      {
        marks.map((m, i) => (
          <>
            <span class="doc__mark" style={`left:${m.x}px;top:${m.y}px`} data-doc-mark>
              <span />
            </span>
            <span class="doc__badge" style={`left:${m.bx}px;top:${m.by}px`}>
              {i + 1}
            </span>
          </>
        ))
      }
      <span class="doc__scan" aria-hidden="true" data-doc-scan></span>
    </div>

    <svg class="doc__links" viewBox="0 0 412 211" width="412" height="211" aria-hidden="true">
      {paths.map((p) => <path class="doc__link" d={p} data-doc-link />)}
      {paths.map(() => <circle class="doc__pulse" r="2.4" cx="0" cy="0" data-doc-pulse />)}
    </svg>

    <div class="doc__fields">
      {
        d.fields.map((f, i) => (
          <div class="doc__field" data-doc-field>
            <span class="doc__num">{i + 1}</span>
            <span class="doc__field-text">
              <span class="doc__label">{f.label}</span>
              <span class="doc__value" data-doc-value>
                {f.value}
              </span>
            </span>
          </div>
        ))
      }
    </div>
  </div>

  <p class="doc__caption" data-doc-caption>{d.caption}</p>
</div>

<style>
  .doc {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    height: 300px;
    padding-inline: 24px;
    border-radius: var(--r-card);
    background: var(--c-bg-light);
    overflow: hidden;
  }

  .doc__block {
    position: relative;
    width: 412px;
    height: 211px;
    flex: none;
  }

  .doc__page {
    position: absolute;
    top: 0;
    left: 0;
    width: 170px;
    height: 211px;
    border: 1px solid rgba(131, 77, 251, 0.16);
    border-radius: var(--r-card);
    background: #fff;
    filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.12));
    overflow: hidden;
  }

  .doc__page > * {
    position: absolute;
  }

  .doc__logo {
    top: 11px;
    left: 11px;
    width: 20px;
    height: 20px;
    border-radius: 4px;
    background: #eeebff;
  }

  .doc__line {
    height: 4px;
    border-radius: 4px;
    background: #eeebff;
  }

  /* A marked passage: a hairline box round a text line. Lights while the
     scan reads it. */
  .doc__mark {
    width: 86px;
    padding: 4px 2px;
    /* Figma's 0.2px hairline. Chrome rounds a sub-pixel border up to a whole
       pixel at full strength, so the weight goes into the alpha instead. */
    border: 1px solid rgba(131, 77, 251, 0.4);
    border-radius: 2px;
    transition: background-color 0.4s var(--ease-out);
  }

  .doc__mark > span {
    display: block;
    height: 4px;
    border-radius: 4px;
    background: #eeebff;
  }

  .doc__mark.is-read {
    background: rgba(131, 77, 251, 0.14);
  }

  .doc__badge {
    width: 8px;
    padding: 1px;
    border-radius: var(--r-pill);
    background: var(--c-accent);
    font-size: 5px;
    line-height: 6px;
    text-align: center;
    color: #fff;
  }

  /* The reader: a soft accent band with a bright leading edge. */
  .doc__scan {
    top: 0;
    left: 0;
    width: 100%;
    height: 18px;
    background: linear-gradient(to bottom, rgba(131, 77, 251, 0), rgba(131, 77, 251, 0.12) 85%, var(--c-accent) 100%);
    opacity: 0;
    pointer-events: none;
  }

  .doc__links {
    position: absolute;
    inset: 0;
    overflow: visible;
  }

  .doc__link {
    fill: none;
    stroke: var(--c-accent);
    stroke-width: 0.6;
    stroke-dasharray: 3.9 3.9;
    transition: opacity 0.4s var(--ease-out);
  }

  /* Runs along a connector carrying the read value; hidden at rest. */
  .doc__pulse {
    fill: var(--c-accent);
    opacity: 0;
  }

  .doc__fields {
    position: absolute;
    top: 37px;
    left: 221px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 191px;
  }

  .doc__field {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 8px;
    border: 1px solid rgba(131, 77, 251, 0.16);
    border-radius: 4px;
    background: #fff;
    filter: drop-shadow(0 2px 3px rgba(131, 77, 251, 0.12));
  }

  .doc__num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 14px;
    padding: 2px;
    border-radius: var(--r-pill);
    background: var(--c-accent);
    font-size: 10px;
    line-height: 10px;
    letter-spacing: var(--tr-body);
    color: #fff;
  }

  .doc__field-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 10px;
  }

  .doc__label {
    line-height: normal;
    letter-spacing: 0.6px;
    color: var(--c-muted);
  }

  .doc__value {
    display: inline-block;
    line-height: 12px;
    letter-spacing: var(--tr-body);
    color: var(--c-ink);
    white-space: nowrap;
  }

  .doc__caption {
    width: 100%;
    font-size: var(--fs-xxs);
    line-height: normal;
    letter-spacing: 0.6px;
    text-align: center;
    color: var(--c-accent);
  }

  @media (max-width: 700px) {
    .doc {
      padding-inline: 12px;
    }

    .doc__block {
      width: 330px;
    }

    .doc__page {
      transform: scale(0.76);
      transform-origin: 0 50%;
    }

    .doc__links {
      translate: -41px 0;
    }

    .doc__fields {
      left: 180px;
      width: 150px;
    }
  }
</style>
