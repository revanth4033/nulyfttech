---
import EyebrowBadge from "./EyebrowBadge.astro";

/**
 * Eyebrow + heading + sub-line, centred.
 *
 * This exact stack recurs across most sections (Key Highlights, What We Do,
 * Selected Work, Why nuLyft, Our Process, Technology, Clients), so it lives
 * here rather than being rebuilt each time. `tone` flips it for the dark bands.
 */
interface Props {
  /** Omit, or pass `null`, for headers that carry no badge. */
  eyebrow?: string | null;
  title: string;
  /** Optional supporting line under the heading. */
  body?: string;
  tone?: "light" | "dark";
  /** `lg` is the 40px section heading; `md` is the 32px one (Talent stats). */
  size?: "lg" | "md";
  class?: string;
}

const { eyebrow, title, body, tone = "light", size = "lg", class: className } = Astro.props;
---

<header class:list={["head", `head--${tone}`, `head--${size}`, className]}>
  <div class="head__top">
    {
      eyebrow && (
        <EyebrowBadge variant={tone === "dark" ? "dark" : "section"} data-animate>
          {eyebrow}
        </EyebrowBadge>
      )
    }
    <h2 class="head__title" data-animate>{title}</h2>
  </div>
  {body && <p class="head__body" data-animate>{body}</p>}
</header>

<style>
  .head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    width: 100%;
  }

  .head__top {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .head__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--head-fs, var(--fs-h2));
    line-height: 1.3;
    letter-spacing: var(--tr-h2);
    text-transform: capitalize;
    text-align: center;
    color: var(--c-heading);
    text-wrap: balance;
  }

  .head__body {
    width: 624px;
    max-width: 100%;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    text-align: center;
    color: var(--c-muted);
  }

  /* Dark bands: Narrative/Talent Intelligence, Why nuLyft, the footer CTA. */
  .head--md {
    --head-fs: var(--fs-h3);
  }

  .head--dark .head__title {
    color: #fff;
  }

  .head--dark .head__body {
    color: color-mix(in srgb, #fff 72%, transparent);
  }

  @media (max-width: 900px) {
    .head__title {
      font-size: 32px;
      letter-spacing: -1px;
    }
  }

  /* Mobile — the size every 393 frame draws this header at (536:13471 and
     its siblings): 20/-1 for the title over a 12/18 body. These were being
     rendered at 26px and 16px, which alone put Our Process 113px over its
     frame before anything else was measured. */
  @media (max-width: 560px) {
    .head__title {
      font-size: 20px;
      letter-spacing: -1px;
      line-height: normal;
    }

    .head__body {
      font-size: 12px;
      line-height: 18px;
    }
  }
</style>
